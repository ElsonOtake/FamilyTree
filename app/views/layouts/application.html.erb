<!DOCTYPE html>
<html>
  <head>
    <title>FamilyTree</title>
    <%= favicon_link_tag asset_path('EAO.png') %>
    <meta name='viewport' content='width=device-width,initial-scale=1'>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Apply the saved theme before paint to avoid a flash of the wrong mode. %>
    <script>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
  </head>

  <body>
    <%= render 'layouts/navbar' %>

    <div data-controller='dark-mode' class='fixed bottom-4 right-4 z-40'>
      <button type='button'
              class='btn btn-secondary btn-sm shadow-md'
              data-action='click->dark-mode#toggle'>
        <%= heroicon(:moon, class: 'size-4 hidden dark:inline') %>
        <%= heroicon(:sun, class: 'size-4 inline dark:hidden') %>
        <span data-dark-mode-target='label'>Dark mode</span>
      </button>
    </div>

    <main class='mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8'>
      <div id='flash'>
        <%= render 'shared/flash' %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
