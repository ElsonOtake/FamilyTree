<nav class="navbar" role="navigation" aria-label="main navigation">
  <div class="navbar-brand m-4">
    <a class="navbar-item" href="<%= root_path %>">
      <img src="<%= image_path "EAO.png" %>" width="90" height="45">
    </a>

    <a
      role="button"
      class="navbar-burger"
      aria-label="menu"
      aria-expanded="false"
      data-target="navMenu"
      data-controller="stimulus"
      data-action="stimulus#burger"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div id="navMenu" class="navbar-menu m-4">
    <%# <div class="navbar-start">
      <a class="navbar-item">
        Novo
      </a>

      <a class="navbar-item">
        Aniversários
      </a>
      
      <a class="navbar-item">
        Estatísticas
      </a>

      <div class="navbar-item has-dropdown is-hoverable">
        <a class="navbar-link">
          Mais
        </a>

        <div class="navbar-dropdown">
          <a class="navbar-item">
            Sobre
          </a>
          <a class="navbar-item">
            Log
          </a>
          <a class="navbar-item">
            Backup
          </a>
          <a class="navbar-item">
            Contato
          </a>
          <hr class="navbar-divider">
          <a class="navbar-item">
            Informe um erro
          </a>
        </div>
      </div>
    </div> %>

    <div class="navbar-end">
      <% if user_signed_in? %>
        <% locales = {
              pt: "Português",
              en: "English",
              ja: "日本語"
            }.with_indifferent_access
        %>
        <div class="navbar-item has-dropdown is-hoverable">
          <a class="navbar-link">
            <%= locales[current_user.locale] %>
          </a>

          <div class="navbar-dropdown is-active">
            <% locales.each do |key, value| %>
              <%= link_to value, person_locale_change_path(current_user, key), data: { turbo_method: :patch }, class: "navbar-item" unless key.to_s == current_user.locale %>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="navbar-item is-hidden-touch">
        <div class="buttons">
          <% if user_signed_in? %>
            <%= link_to t(:edit_profile), edit_user_registration_path, class: "button is-link is-outlined" %>
            <%= button_to t(:log_out), destroy_user_session_path, method: :delete, class: "button is-danger is-outlined" %>
          <% else %>
            <%= link_to "Sign Up", new_user_registration_path, class: "button is-link is-outlined" %>
            <%= link_to "Log in", new_user_session_path, class: "button is-info is-outlined" %>
          <% end %>
        </div>
      </div>
      <div class="navbar-item is-hidden-desktop">
          <% if user_signed_in? %>
            <%= link_to t(:edit_profile), edit_user_registration_path, class: "navbar-item" %>
            <%= link_to t(:log_out), destroy_user_session_path, data: { turbo_method: :delete }, class: "navbar-item" %>
          <% else %>
            <%= link_to "Sign Up", new_user_registration_path, class: "navbar-item" %>
            <%= link_to "Log in", new_user_session_path, class: "navbar-item" %>
          <% end %>
      </div>
    </div>
  </div>
</nav>  