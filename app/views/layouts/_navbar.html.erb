<% locales = { pt: 'Português', en: 'English', ja: '日本語' }.with_indifferent_access %>
<% current_locale = user_signed_in? ? current_user.locale : (session[:locale] ||= I18n.default_locale.to_s) %>

<nav data-controller='navbar'
     class='sticky top-0 z-30 bg-brand-700 text-white shadow-md dark:bg-slate-800'
     aria-label='main navigation'>
  <div class='mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8'>
    <%# Brand %>
    <%= link_to root_path, class: 'flex shrink-0 items-center gap-3' do %>
      <%= image_tag 'EAO.png', width: 72, class: 'h-9 w-auto' %>
      <span class='hidden text-sm font-bold sm:block'>
        <%= user_signed_in? ? "Family Tree — #{current_user.name}" : 'Family Tree' %>
      </span>
    <% end %>

    <%# Desktop links %>
    <div class='hidden items-center gap-1 lg:flex'>
      <% if user_signed_in? %>
        <%= link_to people_path, class: 'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:users, class: 'size-5') %><span><%= t('people.index.title', default: 'People') %></span>
        <% end %>

        <%= render 'layouts/nav_dropdown', label: t('.statistics', default: 'Statistics'), icon: :chart_bar do %>
          <%= render 'layouts/nav_dropdown_link', path: birthdays_people_path, icon: :cake, label: t('.birthdays', default: 'Birthdays') %>
          <%= render 'layouts/nav_dropdown_link', path: statistics_path, icon: :chart_bar, label: t('.family_stats', default: 'Family Statistics') %>
        <% end %>
      <% end %>

      <%# Locale switcher %>
      <%= render 'layouts/nav_dropdown', label: locales[current_locale], icon: :globe_alt do %>
        <% locales.each do |key, value| %>
          <% next if key.to_s == current_locale.to_s %>
          <% path = user_signed_in? ? user_locale_change_path(current_user, key) : locale_change_unidentified_users_path(key) %>
          <%= link_to value, path, data: { turbo_method: :patch }, class: 'block rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 dark:text-slate-200 dark:hover:bg-slate-700' %>
        <% end %>
      <% end %>

      <% if user_signed_in? %>
        <%= render 'layouts/nav_dropdown', label: t('.more'), icon: :ellipsis_vertical do %>
          <%= render 'layouts/nav_dropdown_link', path: about_path, icon: :information_circle, label: t('.about') %>
          <%= render 'layouts/nav_dropdown_link', path: mcp_access_users_path, icon: :cpu_chip, label: t('.mcp_access') %>
          <% if policy(User).roles? %>
            <div class='my-1 border-t border-slate-100 dark:border-slate-700'></div>
            <%= render 'layouts/nav_dropdown_link', path: roles_users_path, icon: :shield_check, label: t('.roles') %>
            <%= render 'layouts/nav_dropdown_link', path: admin_users_path, icon: :squares_2x2, label: t('.dashboard') %>
          <% end %>
          <% unless current_user.omniauth_login? %>
            <div class='my-1 border-t border-slate-100 dark:border-slate-700'></div>
            <%= render 'layouts/nav_dropdown_link', path: edit_user_registration_path, icon: :pencil_square, label: t('.edit_profile') %>
          <% end %>
        <% end %>

        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: 'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:arrow_right_on_rectangle, class: 'size-5') %><span><%= t('.log_out') %></span>
        <% end %>
      <% else %>
        <%= link_to new_user_registration_path, class: 'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:user_plus, class: 'size-5') %><span><%= t('devise.registrations.new.sign_up') %></span>
        <% end %>
        <%= link_to new_user_session_path, class: 'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:arrow_left_on_rectangle, class: 'size-5') %><span><%= t('devise.sessions.new.log_in') %></span>
        <% end %>
      <% end %>
    </div>

    <%# Mobile hamburger %>
    <button type='button'
            class='inline-flex items-center rounded-lg p-2 hover:bg-white/10 lg:hidden'
            data-action='navbar#toggleMenu'
            aria-label='menu'>
      <%= heroicon(:bars, class: 'size-6') %>
    </button>
  </div>

  <%# Mobile menu %>
  <div data-navbar-target='menu' class='hidden border-t border-white/10 px-4 pb-4 pt-2 lg:hidden'>
    <div class='flex flex-col gap-1'>
      <% if user_signed_in? %>
        <%= link_to people_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:users, class: 'size-5') %><%= t('people.index.title', default: 'People') %>
        <% end %>
        <%= link_to birthdays_people_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:cake, class: 'size-5') %><%= t('.birthdays', default: 'Birthdays') %>
        <% end %>
        <%= link_to statistics_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:chart_bar, class: 'size-5') %><%= t('.family_stats', default: 'Family Statistics') %>
        <% end %>
        <%= link_to about_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:information_circle, class: 'size-5') %><%= t('.about') %>
        <% end %>
        <%= link_to mcp_access_users_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:cpu_chip, class: 'size-5') %><%= t('.mcp_access') %>
        <% end %>
        <% if policy(User).roles? %>
          <%= link_to roles_users_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
            <%= heroicon(:shield_check, class: 'size-5') %><%= t('.roles') %>
          <% end %>
          <%= link_to admin_users_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
            <%= heroicon(:squares_2x2, class: 'size-5') %><%= t('.dashboard') %>
          <% end %>
        <% end %>
        <% unless current_user.omniauth_login? %>
          <%= link_to edit_user_registration_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
            <%= heroicon(:pencil_square, class: 'size-5') %><%= t('.edit_profile') %>
          <% end %>
        <% end %>
      <% end %>

      <div class='my-1 border-t border-white/10'></div>
      <p class='px-3 pb-1 text-xs uppercase tracking-wide text-white/60'><%= locales[current_locale] %></p>
      <% locales.each do |key, value| %>
        <% next if key.to_s == current_locale.to_s %>
        <% path = user_signed_in? ? user_locale_change_path(current_user, key) : locale_change_unidentified_users_path(key) %>
        <%= link_to value, path, data: { turbo_method: :patch }, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-white/10' %>
      <% end %>

      <div class='my-1 border-t border-white/10'></div>
      <% if user_signed_in? %>
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:arrow_right_on_rectangle, class: 'size-5') %><%= t('.log_out') %>
        <% end %>
      <% else %>
        <%= link_to new_user_registration_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:user_plus, class: 'size-5') %><%= t('devise.registrations.new.sign_up') %>
        <% end %>
        <%= link_to new_user_session_path, class: 'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-white/10' do %>
          <%= heroicon(:arrow_left_on_rectangle, class: 'size-5') %><%= t('devise.sessions.new.log_in') %>
        <% end %>
      <% end %>
    </div>
  </div>
</nav>
