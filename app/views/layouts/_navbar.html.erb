<nav class='navigation navbar is-dark has-shadow' role='navigation' aria-label='main navigation' data-controller='stimulus'>
  <div class='navbar-brand'>
    <a class='navbar-item' href=<%= root_path %>>
      <img src=<%= image_path 'EAO.png' %> width='90' height='45' class='mr-3'>
      <div class='is-hidden-touch'>
        <% if user_signed_in? %>
          <p class='title is-6 has-text-white mb-0'>Family Tree - <%= current_user.name %></p>
        <% else %>
          <p class='title is-6 has-text-white mb-0'>Family Tree</p>
        <% end %>
      </div>
    </a>

    <a
      role='button'
      class='navbar-burger has-text-white'
      aria-label='menu'
      data-stimulus-target='burger'
      data-action='stimulus#burger'
    >
      <span aria-hidden='true'></span>
      <span aria-hidden='true'></span>
      <span aria-hidden='true'></span>
    </a>
  </div>

  <div id='navMenu' class='navbar-menu' data-stimulus-target='menu' style='background-color: white !important;'>
    <div class='navbar-start'>
      <% if user_signed_in? %>
        <%= link_to people_path, class: 'navbar-item', style: 'color: #000000 !important; font-weight: 700 !important;' do %>
          <span class='icon-text'>
            <span class='icon'><i class='fas fa-users'></i></span>
            <span style='color: #000000 !important; font-weight: 700 !important;'><%= t('people.index.title', default: 'People') %></span>
          </span>
        <% end %>
        <div class='navbar-item has-dropdown is-hoverable'>
          <a class='navbar-link' style='color: #000000 !important; font-weight: 700 !important;'>
            <span class='icon-text'>
              <span class='icon'><i class='fas fa-chart-line'></i></span>
              <span><%= t('.statistics', default: 'Statistics') %></span>
            </span>
          </a>
          <div class='navbar-dropdown'>
            <%= link_to birthdays_people_path, class: 'navbar-item' do %>
              <span class='icon-text'>
                <span class='icon has-text-info'><i class='fas fa-birthday-cake'></i></span>
                <span><%= t('.birthdays', default: 'Birthdays') %></span>
              </span>
            <% end %>
            <%= link_to statistics_path, class: 'navbar-item' do %>
              <span class='icon-text'>
                <span class='icon has-text-success'><i class='fas fa-chart-bar'></i></span>
                <span><%= t('.family_stats', default: 'Family Statistics') %></span>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <div class='navbar-end'>
      <% locales = {
            pt: 'Português',
            en: 'English',
            ja: '日本語'
          }.with_indifferent_access
      %>
      <div class='navbar-item has-dropdown is-hoverable'>
        <a class='navbar-link has-text-white'>
          <span class='icon-text'>
            <span class='icon'><i class='fas fa-globe'></i></span>
            <span>
              <% if user_signed_in? %>
                <%= locales[current_user.locale] %>
              <% else %>
                <% session[:locale] ||= I18n.default_locale.to_s %>
                <%= locales[session[:locale]] %>
              <% end %>
            </span>
          </span>
        </a>

        <div class='navbar-dropdown is-right'>
          <% locales.each do |key, value| %>
            <% if user_signed_in? %>
              <%= link_to value, user_locale_change_path(current_user, key), data: { turbo_method: :patch }, class: 'navbar-item' unless key.to_s == current_user.locale %>
            <% else %>
              <%= link_to value, locale_change_unidentified_users_path(key), data: { turbo_method: :patch }, class: 'navbar-item' unless key.to_s == session[:locale] %>
            <% end %>
          <% end %>
        </div>
      </div>
      
      <% if user_signed_in? %>
        <div class='navbar-item has-dropdown is-hoverable'>
          <a class='navbar-link' style='color: #000000 !important; font-weight: 700 !important;'>
            <span class='icon-text'>
              <span class='icon'><i class='fas fa-ellipsis-v'></i></span>
              <span><%= t('.more')%></span>
            </span>
          </a>
          <div class='navbar-dropdown is-right'>
            <%= link_to about_path, class: 'navbar-item' do %>
              <span class='icon-text'>
                <span class='icon has-text-info'><i class='fas fa-info-circle'></i></span>
                <span><%= t('.about') %></span>
              </span>
            <% end %>
            <%#= link_to 'Log', nil, class: 'navbar-item' %>
            <%#= link_to 'Aniversários', nil, class: 'navbar-item' %>
            <%#= link_to 'Estatísticas', nil, class: 'navbar-item' %>
            <%#= link_to 'Backup', nil, class: 'navbar-item' %>
            <%#= link_to 'Contato', nil, class: 'navbar-item' %>
            <% if policy(User).roles? %>
              <%#= link_to t('.download_users_csv'), download_users_path(format: :csv), class: 'navbar-item' %>
              <%#= link_to t('.download_roles_csv'), download_roles_path(format: :csv), class: 'navbar-item' %>
              <%#= link_to t('.download_people_csv'), download_people_path(format: :csv), class: 'navbar-item' %>
              <%#= link_to t('.download_couples_csv'), download_couples_path(format: :csv), class: 'navbar-item' %>
              <%#= link_to t('.download_children_csv'), download_children_path(format: :csv), class: 'navbar-item' %>
              <%#= link_to t('.download_events_csv'), download_events_path(format: :csv), class: 'navbar-item' %>
              <hr class='navbar-divider'>
              <%= link_to roles_users_path, class: 'navbar-item' do %>
                <span class='icon-text'>
                  <span class='icon has-text-warning'><i class='fas fa-user-shield'></i></span>
                  <span><%= t('.roles') %></span>
                </span>
              <% end %>
              <%= link_to admin_users_path, class: 'navbar-item' do %>
                <span class='icon-text'>
                  <span class='icon has-text-primary'><i class='fas fa-tachometer-alt'></i></span>
                  <span><%= t('.dashboard') %></span>
                </span>
              <% end %>
            <% end %>
            <%# <hr class='navbar-divider'> %>
            <hr class='navbar-divider'>
            <% unless current_user.omniauth_login? %>
              <%= link_to edit_user_registration_path, class: 'navbar-item' do %>
                <span class='icon-text'>
                  <span class='icon has-text-info'><i class='fas fa-user-edit'></i></span>
                  <span><%= t('.edit_profile') %></span>
                </span>
              <% end %>
            <% end %>
            <%#= link_to 'Informe um erro', nil, class: 'navbar-item' %>
          </div>
        </div>

        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: 'navbar-item', style: 'color: #000000 !important; font-weight: 700 !important;' do %>
          <span class='icon-text'>
            <span class='icon has-text-danger'><i class='fas fa-sign-out-alt'></i></span>
            <span><%= t('.log_out') %></span>
          </span>
        <% end %>
      <% else %>
        <%= link_to new_user_registration_path, class: 'navbar-item', style: 'color: #000000 !important; font-weight: 700 !important;' do %>
          <span class='icon-text'>
            <span class='icon has-text-success'><i class='fas fa-user-plus'></i></span>
            <span><%= t('devise.registrations.new.sign_up') %></span>
          </span>
        <% end %>
        <%= link_to new_user_session_path, class: 'navbar-item', style: 'color: #000000 !important; font-weight: 700 !important;' do %>
          <span class='icon-text'>
            <span class='icon has-text-info'><i class='fas fa-sign-in-alt'></i></span>
            <span><%= t('devise.sessions.new.log_in') %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</nav>
