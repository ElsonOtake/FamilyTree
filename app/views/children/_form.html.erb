<%= form_with url: person_couple_children_path(person, couple), data: { controller: "stimulus", action: "turbo:submit-end->stimulus#submitEnd" } do |form| %>
  <div class="field column">
    <%= form.label :child, t('.child'), style: "display: block", class: "label" %>
    <div class="control">
      <%= form.select :child_id, people&.collect { |c| [c.name, c.id] }, { prompt: t('.select_child') }, { class: 'input' } %>
    </div>
  </div>

  <div class="control is-flex is-justify-content-space-between">
    <%= form.submit class: "button is-info is-rounded" %>
    <button
      data-controller="stimulus"
      data-action="stimulus#closeAllModals"
      class="button is-info is-rounded">
      <%= t(:back) %>
    </button>
  </div>
<% end %>
