<div class='space-y-4'>
  <div class='field'>
    <label class='label'>
      <%= heroicon(:magnifying_glass, class: 'inline size-4 text-brand-500') %>
      <%= t('children.form.search_existing_person') %>
    </label>
    <p class='mb-2 text-xs text-slate-400'><%= t('children.form.search_help_text') %></p>
    <%= render 'people/search_child_name' %>
  </div>

  <%= form_with url: person_couple_children_path(person, couple), data: { controller: 'stimulus', action: 'turbo:submit-end->stimulus#submitEnd' } do |form| %>
    <div class='rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40'>
      <div class='field'>
        <%= form.label :child, t('.selected_person'), class: 'label' %>
        <%= form.number_field :child_id, class: 'hidden' %>
        <%= form.text_field :name, class: 'input', readonly: true, required: true,
            placeholder: t('children.form.no_person_selected') %>
        <p class='mt-1 text-xs text-slate-400'><%= t('children.form.selected_person_help') %></p>
      </div>
    </div>

    <div class='mt-6 flex justify-center gap-3'>
      <%= form.submit t('children.form.create_child'), class: 'btn btn-primary cursor-pointer', disabled: true, id: 'submit-button' %>
      <%= link_to t(:back), nil, data: { controller: 'stimulus', action: 'stimulus#closeAllModals' }, class: 'btn btn-secondary' %>
    </div>
  <% end %>
</div>
