<%= form_with do |form| %>
  <div class="field column">
    <%= form.label "Child", style: "display: block", class: "label" %>
    <div class="control">
      <%= form.select :child, @people&.collect { |c| [c.name, c.id] }, {}, { class: 'input' } %>
    </div>
  </div>

  <div class="control">
    <%= form.submit class: "button is-link is-light" %>
  </div>
<% end %>
