<%= turbo_frame_tag 'new_child' do %>
  <h1 class='mb-4 text-xl font-bold text-slate-800 dark:text-slate-100'>
    <%= t('helpers.submit.create', model: t('children.form.child')) %> — <%= @person.name %>
  </h1>

  <div data-controller='tabs'>
    <div class='mb-4 flex gap-1 border-b border-slate-200 dark:border-slate-700'>
      <button type='button' data-tabs-target='tab' data-tabs-panel-param='new-child' data-action='tabs#select'
              class='flex items-center gap-1.5 border-b-2 border-brand-500 px-3 py-2 text-sm font-medium text-brand-600'>
        <%= heroicon(:user_plus, class: 'size-4') %><%= t('children.form.new_person') %>
      </button>
      <button type='button' data-tabs-target='tab' data-tabs-panel-param='existing-child' data-action='tabs#select'
              class='flex items-center gap-1.5 border-b-2 border-transparent px-3 py-2 text-sm font-medium text-slate-500'>
        <%= heroicon(:user, class: 'size-4') %><%= t('children.form.existing_person') %>
      </button>
    </div>

    <div data-tabs-target='panel' data-tabs-panel='new-child'>
      <%= render 'people/form', person: Person.new, couple: @couple.id, mate: nil %>
    </div>
    <div data-tabs-target='panel' data-tabs-panel='existing-child' class='hidden'>
      <%= render 'form', person: @person, couple: @couple, people: @people %>
    </div>
  </div>
<% end %>
