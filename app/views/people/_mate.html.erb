<% couple = Couple.couple(person, mate) %>
<div id=<%= dom_id couple %> class='media'>
  <div class='media-left'>
    <%= render 'people/icon', person: mate %>
  </div>
  <div class='media-content'>
    <p class='title is-6'>
      <%= link_to mate.name, person_path(mate), class: 'has-text-dark' %>
      <% if policy(couple).destroy? %>
        <%= link_to icon('fa-solid', 'link-slash', class: 'has-text-danger ml-2'),
            couple,
            data: {
              turbo_method: :delete,
              turbo_confirm: t('confirm.messages.unlink_mate', person_name: person.name, mate_name: mate.name)
            },
            title: t('helpers.submit.unlink', model: t('people.show.mate'))
        %>
      <% end %>
      <% if policy(person).new? %>
        <%= link_to icon('fa-solid', 'user-plus', class: 'has-text-success ml-2'),
          new_person_couple_child_path(person, couple),
          data: {
            turbo_frame: 'new_child',
            controller: 'stimulus',
            stimulus_id_value: 'child_new',
            action: 'stimulus#open'
          },
          title: t('helpers.submit.create', model: t('children.form.child'))
        %>
      <% end %>
      <% if policy(couple).edit? %>
        <%= link_to icon('fa-solid', 'pen', class: 'has-text-info ml-2'),
          edit_person_couple_path(person, couple),
          data: {
            turbo_frame: 'edit_couple',
            controller: 'stimulus',
            stimulus_id_value: 'couple_edit',
            action: 'stimulus#open'
          },
          title: t('helpers.submit.edit', model: t('people.show.mate'))
        %>
      <% end %>
    </p>
  </div>
</div>