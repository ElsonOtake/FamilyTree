<% couple = Couple.couple(person, mate) %>
<div id='<%= dom_id couple %>' class='flex items-center gap-3 rounded-lg border border-slate-100 p-2 dark:border-slate-700'>
  <%= render 'people/icon', person: mate %>
  <div class='min-w-0 flex-1'>
    <%= link_to mate.name, person_path(mate),
        class: 'font-medium text-brand-700 hover:underline dark:text-brand-300' %>
  </div>
  <div class='flex items-center gap-1'>
    <% if policy(couple).destroy? %>
      <%= link_to person_couple_path(person, couple), class: 'btn btn-sm btn-ghost',
          data: { turbo_method: :delete, turbo_confirm: t('confirm.messages.unlink_mate', person_name: person.name, mate_name: mate.name) },
          title: t('helpers.submit.unlink', model: t('people.show.mate')) do %>
        <%= heroicon(:link_slash, class: 'size-4 text-red-500') %>
      <% end %>
    <% end %>
    <% if policy(person).new? %>
      <%= link_to new_person_couple_child_path(person, couple), class: 'btn btn-sm btn-ghost',
          data: { turbo_frame: 'new_child', controller: 'stimulus', stimulus_id_value: 'child_new', action: 'stimulus#open' },
          title: t('helpers.submit.create', model: t('children.form.child')) do %>
        <%= heroicon(:user_plus, class: 'size-4 text-emerald-500') %>
      <% end %>
    <% end %>
    <% if policy(couple).edit? %>
      <%= link_to edit_person_couple_path(person, couple), class: 'btn btn-sm btn-ghost',
          data: { turbo_frame: 'edit_couple', controller: 'stimulus', stimulus_id_value: 'couple_edit', action: 'stimulus#open' },
          title: t('helpers.submit.edit', model: t('people.show.mate')) do %>
        <%= heroicon(:pencil, class: 'size-4 text-brand-500') %>
      <% end %>
    <% end %>
  </div>
</div>
