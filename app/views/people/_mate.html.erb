<tr id=<%= dom_id couple %>>
  <td class="is-flex is-justify-content-space-between">
    <div>
      <%= render "people/icon", person: partner %>&nbsp;
      <%= link_to partner.name, person_path(partner) %>
    </div>
    <div>
      <%= link_to icon('fa-solid', 'minus-circle', class: 'has-text-danger'),
          couple,
          data: {
            turbo_method: :delete
          },
          title: "Remove mate"
      %>
      <%= link_to icon('fa-solid', 'plus-circle', class: 'has-text-success ml-2'),
        new_person_couple_child_path(person, couple),
        data: {
          turbo_frame: "new_child",
          controller: "stimulus",
          stimulus_id_value: "child_new",
          action: "stimulus#open"
        },
        title: "Add child"
      %>
      <%= link_to icon('fa-solid', 'pen', class: 'has-text-info ml-2'),
        edit_person_couple_path(person, couple),
        data: {
          turbo_frame: "edit_couple",
          controller: "stimulus",
          stimulus_id_value: "couple_edit",
          action: "stimulus#open"
        },
        title: "Edit mate"
      %>
    </div>
  </td>
</tr>