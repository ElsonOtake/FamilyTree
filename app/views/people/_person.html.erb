<% if person %>
  <div id='<%= dom_id person %>' class='mb-6 space-y-6'>
    <%# Hero %>
    <div class='overflow-hidden rounded-2xl bg-linear-to-r from-brand-600 to-brand-500 text-white shadow-sm'>
      <div class='flex flex-col items-center gap-5 p-6 sm:flex-row sm:items-start'>
        <figure class='size-24 shrink-0 sm:size-32'>
          <% if person.avatar.attached? %>
            <%= link_to rails_blob_path(person.avatar, disposition: 'inline') do %>
              <%= image_tag person.avatar.variant(:thumb), class: 'avatar size-full object-cover ring-2 ring-white/40' %>
            <% end %>
          <% else %>
            <span class='flex size-full items-center justify-center rounded-full bg-white/15 text-white'>
              <%= heroicon(:user, class: 'size-14') %>
            </span>
          <% end %>
        </figure>

        <div class='min-w-0 flex-1 text-center sm:text-left'>
          <h1 class='flex items-center justify-center gap-2 text-2xl font-bold sm:justify-start sm:text-3xl'>
            <%= render 'icon', person: person %>
            <span class='break-words'><%= person.name %></span>
          </h1>
          <% if person.kanji.present? %>
            <p class='mt-1 text-lg text-white/80'><%= person.kanji %></p>
          <% end %>

          <div class='mt-4 flex flex-wrap justify-center gap-2 sm:justify-start'>
            <% if policy(person).edit? %>
              <%= link_to edit_person_path(person), class: 'btn btn-sm btn-secondary',
                data: { turbo_frame: 'edit_person', controller: 'stimulus', stimulus_id_value: 'person_edit', action: 'stimulus#open' },
                title: t('helpers.submit.edit', model: t('people.form.person')) do %>
                <%= heroicon(:pencil_square, class: 'size-4') %><span><%= t('people.show.edit') %></span>
              <% end %>
            <% end %>

            <%= render 'people/favorite_button', person: person, favorite: @favorite, show_label: true %>

            <%= link_to descendentes_person_path(person, format: :pdf), class: 'btn btn-sm btn-secondary', target: '_blank', rel: 'noopener',
              title: t('people.show.download_descendants') do %>
              <%= heroicon(:user_group, class: 'size-4') %><span><%= t('people.show.download_descendants') %></span>
            <% end %>

            <%= link_to descendentes_completo_person_path(person, format: :pdf), class: 'btn btn-sm btn-secondary', target: '_blank', rel: 'noopener',
              title: t('people.show.download_descendants_full') do %>
              <%= heroicon(:user_group, class: 'size-4') %><span><%= t('people.show.download_descendants_full') %></span>
            <% end %>

            <%= link_to ascendentes_person_path(person, format: :pdf), class: 'btn btn-sm btn-secondary', target: '_blank', rel: 'noopener',
              title: t('people.show.ancestor_tree') do %>
              <%= heroicon(:user_group, class: 'size-4') %><span><%= t('people.show.ancestor_tree') %></span>
            <% end %>

            <% if policy(person).destroy? %>
              <%= button_to person_path(person), method: :delete, class: 'btn btn-sm btn-danger',
                form: { data: { turbo_confirm: t('people.show.delete_confirmation', name: person.name) } },
                title: t('helpers.submit.delete', model: t('people.form.person')) do %>
                <%= heroicon(:trash, class: 'size-4') %><span><%= t('people.show.delete') %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Life events %>
    <div class='card'>
      <div class='card-body space-y-4'>
        <div class='rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40'>
          <h3 class='card-title mb-2'>
            <%= heroicon(:calendar, class: 'size-5 text-brand-500') %><%= t('people.show.life_events') %>
          </h3>
          <p class='text-sm text-slate-700 dark:text-slate-200'><%= person.date_text %></p>
          <% if person.birth_text.present? %>
            <p class='mt-1 text-sm text-slate-600 dark:text-slate-300'><%= person.birth_text %></p>
          <% end %>
          <% if !person.alive && person.death_year.blank? %>
            <p class='mt-1 flex items-center gap-1 text-sm text-slate-500'>
              <%= heroicon(:clock, class: 'size-4') %>
              <%= t('people.show.died') %>
            </p>
          <% end %>
        </div>

        <% if person.description.present? %>
          <div class='rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40'>
            <h3 class='card-title mb-2'>
              <%= heroicon(:document_note, class: 'size-5 text-amber-500') %><%= t('people.show.notes') %>
            </h3>
            <p class='whitespace-pre-line text-sm text-slate-700 dark:text-slate-200'><%= person.description %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
