<div id="<%= dom_id person %>">

  <p>
    <strong>Name:</strong>
    <%= person.name %>
  </p>

  <p>
    <strong>gender:</strong>
    <%= icon('fa-solid', 'mars', class: "has-text-info") if person.gender == "M" %>
    <%= icon('fa-solid', 'venus', class: "has-text-danger") if person.gender == "F" %>
    <%= icon('fa-solid', 'mars-and-venus', class: "has-text-primary") if person.gender == "X" %>
    <%= icon('fa-solid', 'dog', class: "has-text-warning") if person.gender == "P" %>
  </p>

  <p>
    <strong>Alive:</strong>
    <%= person.alive %>
  </p>

  <% unless person.birth.nil? %>
    <p>
      <strong>Birth:</strong>
      <%= person.birth %>
      <%= distance_of_time_in_words(person.birth, Date.today) %>
    </p>
  <% end %>

  <% unless person.death.nil? %>
    <p>
      <strong>Death:</strong>
      <%= person.death %>
    </p>
  <% end %>

  <% unless person.description.nil? %>
    <p>
      <%# <strong>description:</strong> %>
      <%= person.description %>
    </p>
  <% end %>

</div>
