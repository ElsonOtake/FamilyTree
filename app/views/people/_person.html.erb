<% if person %>
<div id="<%= dom_id person %>" class='card mb-5'>
  <!-- Hero Section with Avatar and Name -->
  <div class='card-content p-0'>
    <div class='hero is-info is-small'>
      <div class='hero-body px-3 px-6-tablet'>
        <div class='columns is-vcentered is-mobile is-gapless-mobile mb-0'>
          <div class='column is-narrow-mobile is-narrow-tablet pr-3 pr-4-tablet'>
            <figure class='image is-96x96-mobile is-128x128-tablet'>
              <% if person&.avatar&.attached? %>
                <%= link_to image_tag(person&.avatar&.variant(:thumb),
                  class: 'is-rounded',
                  style: 'width: 100%; height: 100%; object-fit: cover;'),
                  person&.avatar %>
              <% else %>
                <img src='<%= image_path '96x96.png' %>'
                  alt='Placeholder image'
                  class='is-rounded'
                  style='width: 100%; height: 100%; background: white;'>
              <% end %>
            </figure>
          </div>
          <div class='column px-0'>
            <div class='is-flex is-flex-direction-column'>
              <div class='mb-3'>
                <h1 class='title is-4-mobile is-2-tablet has-text-white mb-2 mb-3-tablet' style='word-break: break-word; line-height: 1.2;'>
                  <span class='icon-text is-align-items-start'>
                    <span class='icon is-small'>
                      <%= render 'icon', person: person, theme: 'dark' %>
                    </span>
                    <span style='flex: 1;'><%= person&.name || '' %></span>
                  </span>
                </h1>
                <% if person&.kanji.present? %>
                  <p class='subtitle is-6-mobile is-4-tablet has-text-white-ter mb-0 mt-1 ml-0 ml-5-tablet' style='word-break: break-word;'>
                    <%= person&.kanji %>
                  </p>
                <% end %>
              </div>
              <div class='buttons is-flex-wrap-wrap' style='gap: 0.5rem;'>
                <!-- Edit Button -->
                <% if person && policy(person).edit? %>
                  <%= link_to edit_person_path(person),
                    class: 'button is-small is-white is-outlined',
                    data: {
                      turbo_frame: 'edit_person',
                      controller: 'stimulus',
                      stimulus_id_value: 'person_edit',
                      action: 'stimulus#open'
                    },
                    title: t('helpers.submit.edit', model: t('people.form.person')) do %>
                    <span class='icon'>
                      <i class='fas fa-edit'></i>
                    </span>
                    <span><%= t('people.show.edit') %></span>
                  <% end %>
                <% end %>
                
                <!-- Favorite Toggle Button -->
                <% if @favorite %>
                  <%= button_to person_favorite_path(person, @favorite), 
                    method: :delete,
                    remote: true,
                    data: { 
                      controller: 'favorites',
                      action: 'click->favorites#toggle'
                    },
                    class: 'button is-small is-danger',
                    title: t('favorites.remove') do %>
                    <span class='icon'>
                      <i class='fas fa-heart'></i>
                    </span>
                    <span><%= t('favorites.remove') %></span>
                  <% end %>
                <% else %>
                  <%= button_to person_favorites_path(person), 
                    remote: true,
                    data: { 
                      controller: 'favorites',
                      action: 'click->favorites#toggle'
                    },
                    class: 'button is-small is-white is-outlined',
                    title: t('favorites.add') do %>
                    <span class='icon'>
                      <i class='far fa-heart'></i>
                    </span>
                    <span><%= t('favorites.add') %></span>
                  <% end %>
                <% end %>
                <% if person && policy(person).destroy? %>
                  <form action="<%= person_path(person) %>" method="post" style="display: inline;">
                    <input type="hidden" name="_method" value="delete">
                    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                    <button type="submit" 
                            class="button is-small is-danger"
                            title="<%= t('helpers.submit.delete', model: t('people.form.person')) %>"
                            onclick="return confirm('<%= j(t('people.show.delete_confirmation', name: person&.name)) %>')">
                      <span class="icon">
                        <i class="fas fa-trash"></i>
                      </span>
                      <span><%= t('people.show.delete') %></span>
                    </button>
                  </form>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Person Details -->
  <div class='card-content'>
    <div class='columns'>
      <div class='column'>
        <!-- Life Dates -->
        <div class='box'>
          <h3 class='title is-5 mb-3'>
            <span class='icon-text'>
              <span class='icon has-text-info'>
                <i class='fas fa-calendar'></i>
              </span>
              <span><%= t('people.show.life_events') %></span>
            </span>
          </h3>
          <div class='content'>
            <p class='mb-2'>
              <%= person&.date_text %>
            </p>
            <% if person&.birth_text.present? %>
              <p class='mb-2'>
                <span class='icon-text'>
                  <span class='icon has-text-info'>
                    <i class='fas fa-map-marker-alt'></i>
                </span>
                  <span><%= person&.birth_text %></span>
                </span>
              </p>
            <% end %>
            <% unless person&.alive %>
              <p class='mb-2'>
                <span class='icon-text'>
                  <span class='icon has-text-danger'>
                    <i class='fas fa-cross'></i>
                  </span>
                  <span><%= t('people.show.died') %>: <%= person&.death_date_formatted if person&.death_date_formatted.present? %></span>
                </span>
              </p>
            <% end %>
          </div>
        </div>

        <!-- Description/Notes -->
        <% if person&.description.present? %>
          <div class='box'>
            <h3 class='title is-5 mb-3'>
              <span class='icon-text'>
                <span class='icon has-text-warning'>
                  <i class='fas fa-sticky-note'></i>
                </span>
                <span><%= t('people.show.notes') %></span>
              </span>
            </h3>
            <div class='content'>
              <p><%= person&.description %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>