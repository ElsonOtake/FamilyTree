<div id='<%= "child_#{child.id}" %>' class='flex items-center gap-3 rounded-lg border border-slate-100 p-2 dark:border-slate-700'>
  <%= render 'people/icon', person: child %>
  <div class='min-w-0 flex-1'>
    <%= link_to child.name, person_path(child),
        class: 'font-medium text-brand-700 hover:underline dark:text-brand-300' %>
  </div>
  <div class='flex items-center gap-1'>
    <% if policy(child).destroy? %>
      <%= link_to person_couple_child_path(person, child.couples.first, child), class: 'btn btn-sm btn-ghost',
          data: { turbo_method: :delete, turbo_confirm: t('confirm.messages.unlink_child', name: child.name) },
          title: t('helpers.submit.unlink', model: t('children.form.child')) do %>
        <%= heroicon(:link_slash, class: 'size-4 text-red-500') %>
      <% end %>
    <% end %>
  </div>
</div>
