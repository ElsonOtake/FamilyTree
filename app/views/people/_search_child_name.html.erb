<%= search_form_for @q, url: search_child_people_path, data: { turbo_frame: 'results' } do |f| %>
  <div class='relative'>
    <span class='pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400'>
      <%= heroicon(:magnifying_glass, class: 'size-5') %>
    </span>
    <%= f.search_field :name_cont, oninput: 'this.form.requestSubmit();',
        class: 'input pl-10', placeholder: t('children.form.type_to_search'), autofocus: true %>
  </div>
<% end %>

<%= turbo_frame_tag 'results' do %>
  <% if @people&.any? %>
    <div class='mt-3 max-h-72 space-y-1 overflow-y-auto'>
      <h4 class='px-1 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400'>
        <%= t('children.form.search_results', count: @people.count) %>
      </h4>
      <% @people.each do |person| %>
        <a class='flex cursor-pointer items-center gap-3 rounded-lg border border-slate-100 p-2 hover:bg-brand-50 dark:border-slate-700 dark:hover:bg-slate-700'
           data-controller='stimulus'
           data-action='click->stimulus#select_child'
           data-stimulus-child-id-param='<%= person.id %>'>
          <%= render 'people/icon', person: person %>
          <div class='min-w-0 flex-1'>
            <p class='font-semibold text-slate-800 dark:text-slate-100'><%= person.name %></p>
            <p class='truncate text-xs text-slate-500'>
              <% if person.birth_year.present? %><%= person.birth_year %><% end %>
              <% if person.father.present? || person.mother.present? %>
                · <%= [person.father&.name, person.mother&.name].compact.join(' & ') %>
              <% end %>
            </p>
          </div>
          <%= heroicon(:arrow_right, class: 'size-4 text-brand-400') %>
        </a>
      <% end %>
    </div>
  <% elsif params.dig(:q, :name_cont).present? %>
    <div class='mt-3 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:bg-amber-900/30 dark:text-amber-200'>
      <%= t('children.form.no_results_found') %>
    </div>
  <% else %>
    <div class='mt-3 rounded-lg bg-blue-50 px-4 py-3 text-sm text-blue-800 dark:bg-blue-900/30 dark:text-blue-200'>
      <%= t('children.form.start_typing_to_search') %>
    </div>
  <% end %>
<% end %>
