<%= form_with model: person, data: { turbo: false, controller: 'stimulus', action: 'turbo:submit-end->stimulus#submitEnd' } do |form| %>
  <% if person.errors.any? %>
    <div class='mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-200 dark:bg-red-900/30 dark:text-red-200'>
      <h2 class='mb-1 font-semibold'><%= t('errors.template.header', count: person.errors.count, model: t('.person')) %></h2>
      <ul class='list-inside list-disc'>
        <% person.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :couple, value: couple %>
  <%= form.hidden_field :mate, value: mate %>

  <div class='space-y-5'>
    <%# Basic info %>
    <div class='field' data-controller='avatar-cropper'>
      <%= form.label :avatar, t('.avatar'), class: 'label' %>
      <%= form.file_field :avatar,
        accept: 'image/png,image/jpeg',
        data: { avatar_cropper_target: 'input', action: 'avatar-cropper#open' },
        class: 'block w-full text-sm text-slate-500 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-brand-700 hover:file:bg-brand-100' %>
      <p class='mt-1 text-sm text-slate-500'><%= t('.avatar_crop_hint') %></p>

      <%# Crop editor: shown after a photo is chosen, hidden again after applying. %>
      <div data-avatar-cropper-target='editor' class='hidden mt-3'>
        <div class='max-w-md'>
          <img data-avatar-cropper-target='image' alt='' class='block max-w-full'>
        </div>
        <div class='mt-2 flex gap-2'>
          <button type='button' data-action='avatar-cropper#apply' class='btn btn-primary'><%= t('.avatar_crop_apply') %></button>
          <button type='button' data-action='avatar-cropper#cancel' class='btn btn-secondary'><%= t('.avatar_crop_cancel') %></button>
        </div>
      </div>

      <img data-avatar-cropper-target='preview' alt='' class='hidden mt-3 size-24 rounded-full object-cover ring-1 ring-brand-200'>
    </div>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
      <div class='field'>
        <%= form.label :name, t('.name'), class: 'label' %>
        <%= form.text_field :name, class: 'input', required: true %>
      </div>
      <div class='field'>
        <%= form.label :kanji, t('.kanji'), class: 'label' %>
        <%= form.text_field :kanji, class: 'input' %>
      </div>
    </div>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
      <div class='field'>
        <span class='label'><%= t('.gender') %></span>
        <div class='flex flex-wrap gap-4'>
          <% [['M', '.male', 'text-male'], ['F', '.female', 'text-female'], ['P', '.pet', 'text-pet'], ['X', '.other', 'text-other']].each do |val, key, color| %>
            <label class='flex items-center gap-1.5 text-sm'>
              <%= form.radio_button :gender, val, class: 'border-slate-300 text-brand-500 focus:ring-brand-400' %>
              <%= heroicon(:user, class: "size-4 #{color}") %><%= t(key) %>
            </label>
          <% end %>
        </div>
      </div>

      <div class='field'>
        <span class='label'><%= t('.alive') %></span>
        <div class='flex flex-wrap gap-4'>
          <label class='flex items-center gap-1.5 text-sm'>
            <%= form.radio_button :alive, true, class: 'border-slate-300 text-brand-500 focus:ring-brand-400' %>
            <%= heroicon(:heart, class: 'size-4 text-emerald-500') %><%= t('.yes') %>
          </label>
          <label class='flex items-center gap-1.5 text-sm'>
            <%= form.radio_button :alive, false, class: 'border-slate-300 text-brand-500 focus:ring-brand-400' %>
            <%= heroicon(:clock, class: 'size-4 text-slate-400') %><%= t('.no') %>
          </label>
        </div>
      </div>
    </div>

    <%# Partial dates %>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
      <div class='field'>
        <%= form.label :birth, t('people.birthday'), class: 'label' %>
        <div class='grid grid-cols-3 gap-2'>
          <%= form.text_field :birth_year, class: 'input', placeholder: t('.yyyy') %>
          <%= form.text_field :birth_month, class: 'input', placeholder: t('.mm') %>
          <%= form.text_field :birth_day, class: 'input', placeholder: t('.dd') %>
        </div>
      </div>
      <div class='field'>
        <%= form.label :death, t('.death'), class: 'label' %>
        <div class='grid grid-cols-3 gap-2'>
          <%= form.text_field :death_year, class: 'input', placeholder: t('.yyyy') %>
          <%= form.text_field :death_month, class: 'input', placeholder: t('.mm') %>
          <%= form.text_field :death_day, class: 'input', placeholder: t('.dd') %>
        </div>
      </div>
    </div>

    <div class='field'>
      <%= form.label :description, t('.remark'), class: 'label' %>
      <%= form.text_area :description, class: 'input', rows: 4 %>
    </div>

    <% unless mate.nil? %>
      <div class='rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40'>
        <h3 class='card-title mb-3'>
          <%= heroicon(:heart, class: 'size-5 text-female') %><%= t('people.form.relationship_info') %>
        </h3>
        <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
          <div class='field'>
            <%= form.label :marriage, t('.marriage'), class: 'label' %>
            <%= form.date_field :marriage, class: 'input' %>
          </div>
          <div class='field'>
            <%= form.label :separation, t('.separation'), class: 'label' %>
            <%= form.date_field :separation, class: 'input' %>
          </div>
        </div>
        <div class='field'>
          <%= form.label :local, t('.local'), class: 'label' %>
          <%= form.text_area :local, class: 'input', rows: 3 %>
        </div>
      </div>
    <% end %>
  </div>

  <div class='mt-6 flex justify-center gap-3'>
    <%= form.submit(person.persisted? ? t('people.form.update_person') : t('people.form.create_person'), class: 'btn btn-primary cursor-pointer') %>
    <button type='button' data-controller='stimulus' data-action='stimulus#closeAllModals' class='btn btn-secondary'>
      <%= t(:back) %>
    </button>
  </div>
<% end %>
