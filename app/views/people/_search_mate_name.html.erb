<%= search_form_for @q, url: search_mate_people_path, data: { turbo_frame: 'results' } do |f| %>
  <div class='field'>
    <div class='control has-icons-left'>
      <%= f.search_field :name_cont, oninput: 'this.form.requestSubmit();', class: 'input', autofocus: true %>
      <span class='icon is-small is-left'>
        <i class='fas fa-magnifying-glass'></i>
      </span>
    </div>
  </div>

  <br>
<% end %>

<%= turbo_frame_tag 'results' do %>
  <ul class='has-background-warning' id='results-list'>
  <% @people.each do |person| %>
    <li class='is-clickable' data-controller='stimulus' data-action='click->stimulus#select_mate' data-stimulus-person-id-param=<%= person.id %> style='width:360px;'>
      <%= person.name %>
    </li>
  <% end %>
  </ul>
<% end %>
