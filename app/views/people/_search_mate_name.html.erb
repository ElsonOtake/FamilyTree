<%= search_form_for @q, url: search_mate_people_path, data: { turbo_frame: 'results' } do |f| %>
  <div class='relative'>
    <span class='pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400'>
      <%= heroicon(:magnifying_glass, class: 'size-5') %>
    </span>
    <%= f.search_field :name_cont, oninput: 'this.form.requestSubmit();', class: 'input pl-10', autofocus: true %>
  </div>
<% end %>

<%= turbo_frame_tag 'results' do %>
  <ul id='results-list' class='mt-3 space-y-1'>
    <% @people.each do |person| %>
      <li class='flex cursor-pointer items-center gap-2 rounded-lg border border-slate-100 p-2 hover:bg-brand-50 dark:border-slate-700 dark:hover:bg-slate-700'
          data-controller='stimulus'
          data-action='click->stimulus#select_mate'
          data-stimulus-person-id-param='<%= person.id %>'>
        <%= render 'people/icon', person: person %>
        <span class='font-medium'><%= person.name %></span>
      </li>
    <% end %>
  </ul>
<% end %>
