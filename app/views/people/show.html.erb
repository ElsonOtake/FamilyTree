<% if @person %>
  <%= render @person %>

  <div class='grid grid-cols-1 gap-6 md:grid-cols-2'>
    <%# Parents %>
    <div class='card'>
      <div class='card-header'>
        <span class='card-title'><%= heroicon(:users, class: 'size-5 text-brand-500') %><%= t('.parents') %></span>
      </div>
      <div class='card-body space-y-3'>
        <% if @person.father.present? || @person.mother.present? %>
          <% [[@person.father, t('people.show.father')], [@person.mother, t('people.show.mother')]].each do |parent, label| %>
            <% next unless parent %>
            <div class='flex items-center gap-3'>
              <%= render 'icon', person: parent %>
              <div>
                <%= link_to parent.name, person_path(parent), class: 'font-medium text-brand-700 hover:underline dark:text-brand-300' %>
                <p class='text-xs text-slate-400'><%= label %></p>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class='empty-state'><%= t('people.show.no_parents') %></p>
        <% end %>
      </div>
    </div>

    <%# Siblings %>
    <div class='card'>
      <div class='card-header'>
        <span class='card-title'><%= heroicon(:user_group, class: 'size-5 text-emerald-500') %><%= t('.siblings') %></span>
      </div>
      <div class='card-body space-y-2'>
        <% siblings = @person.siblings %>
        <% if siblings.any? %>
          <% siblings.each do |sibling| %>
            <div class='flex items-center gap-3'>
              <%= render 'icon', person: sibling %>
              <%= link_to sibling.name, person_path(sibling), class: 'font-medium text-brand-700 hover:underline dark:text-brand-300' %>
            </div>
          <% end %>
        <% else %>
          <p class='empty-state'><%= t('people.show.no_siblings') %></p>
        <% end %>
      </div>
    </div>

    <%# Spouses / partners %>
    <div class='card'>
      <div class='card-header'>
        <span class='card-title'><%= heroicon(:heart, class: 'size-5 text-female') %><%= t('.mate') %></span>
        <% if policy(@person).new? %>
          <%= link_to new_person_couple_path(@person), class: 'btn btn-sm btn-primary',
            data: { turbo_frame: 'new_couple', controller: 'stimulus', stimulus_id_value: 'couple_new', action: 'stimulus#open' },
            title: t('helpers.submit.create', model: t('people.show.mate')) do %>
            <%= heroicon(:plus, class: 'size-4') %><span><%= t('people.show.add') %></span>
          <% end %>
        <% end %>
      </div>
      <div class='card-body'>
        <div class='space-y-2' id='mate'>
          <% if @person.mates.any? %>
            <% @person.mates.each do |mate| %>
              <%= render 'mate', person: @person, mate: mate %>
            <% end %>
          <% else %>
            <p class='empty-state' id='no-mate-message'><%= t('people.show.no_spouse') %></p>
          <% end %>
        </div>
      </div>
    </div>

    <%# Children %>
    <div class='card'>
      <div class='card-header'>
        <span class='card-title'><%= heroicon(:user_plus, class: 'size-5 text-amber-500') %><%= t('.children') %></span>
      </div>
      <div class='card-body'>
        <div class='space-y-2' id='children'>
          <% if @person.children.any? %>
            <% @person.children.each do |child| %>
              <%= render 'child', person: @person, child: child %>
            <% end %>
          <% else %>
            <p class='empty-state' id='no-children-message'><%= t('people.show.no_children') %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class='mt-8 text-center'>
    <%= link_to people_path, class: 'btn btn-secondary' do %>
      <%= heroicon(:arrow_left, class: 'size-5') %><span><%= t('.back_to_people') %></span>
    <% end %>
  </div>

  <%= render 'shared/modal', tag_name: 'new_couple', modal_id: 'couple_new' %>
  <%= render 'shared/modal', tag_name: 'new_child', modal_id: 'child_new' %>
  <%= render 'shared/modal', tag_name: 'edit_person', modal_id: 'person_edit' %>
  <%= render 'shared/modal', tag_name: 'edit_couple', modal_id: 'couple_edit' %>
<% else %>
  <div class='card'>
    <div class='card-body'>
      <p class='text-red-600'><%= t('people.show.person_not_found') %></p>
    </div>
  </div>
<% end %>
