<% unless @mate.nil? %>
  <%= turbo_stream.remove 'no-mate-message' %>
  <%= turbo_stream.append 'mate', partial: 'people/mate', locals: { mate: @mate, person: @person } %>
<% end %>
<% unless @child.nil? %>
  <%= turbo_stream.remove 'no-children-message' %>
  <%= turbo_stream.append 'children', partial: 'people/child', locals: { person: @person, child: @child } %>
<% end %>
<%= render_turbo_stream_flash_messages %>
