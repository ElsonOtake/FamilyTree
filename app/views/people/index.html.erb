<div class="is-flex is-align-items-center mb-4">
  <h1 class="title has-text-info m-0"><%= t('.family_tree') %></h1>
  <%= link_to icon('fa-solid fa-xl', 'user-plus', class: 'has-text-primary ml-4'),
    new_person_path,
    data: {
      turbo_frame: "new_person",
      controller: "stimulus",
      stimulus_id_value: "person_new",
      action: "stimulus#open"
    }
  %>
</div>

<%= search_form_for @q, data: { turbo_frame: :results, turbo_action: :advance } do |f| %>

  <%= f.label :name_cont %>
  <%= f.search_field :name_cont, oninput: "this.form.requestSubmit();" %>

  <%= f.label :birth_eq %>
  <%= f.date_field :birth_eq, oninput: "this.form.requestSubmit();" %>

  <%= f.label :birth_gteq %>
  <%= f.date_field :birth_gteq, oninput: "this.form.requestSubmit();" %>

  <%= f.label :birth_lteq %>
  <%= f.date_field :birth_lteq, oninput: "this.form.requestSubmit();" %>

  <%= f.label :gender_eq %>
  <%= f.select :gender_eq, Person.genders.to_a, { include_blank: true }, onchange: "this.form.requestSubmit();" %>

  <%= f.label :alive_eq %>
  <%= f.select :alive_eq, [true, false], { include_blank: true }, onchange: "this.form.requestSubmit();" %>

  <%= f.label :description_cont %>
  <%= f.search_field :description_cont, oninput: "this.form.requestSubmit();" %>

  <%= f.submit class: "is-hidden" %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: :advance } do %>

  <%== pagy_bulma_nav(@pagy) %>
  <table class="table">
    <thead>
      <tr>
        <th><%= sort_link(@q, :name, 'Name', default_order: :asc) %></th>
        <th><%= sort_link(@q, :gender, 'Gender') %></th>
        <th><%= sort_link(@q, :birth, 'Birth') %></th>
        <th><%= sort_link(@q, :death, 'Death') %></th>
        <th><%= sort_link(@q, :alive, 'Alive') %></th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody id="people">
      <%= render "people/table", people: @people %>
    </tbody>
  </table>

<% end %>

<%= render "shared/modal", tag_name: "new_person", modal_id: "person_new" %>
