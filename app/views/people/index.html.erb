<div class="is-flex is-align-items-center mb-4">
  <h1 class="title has-text-info m-0"><%= t('.family_tree') %></h1>
  <%= link_to icon('fa-solid fa-xl', 'user-plus', class: 'has-text-primary ml-4'),
    new_person_path,
    data: {
      turbo_frame: "new_person",
      controller: "stimulus",
      stimulus_id_value: "person_new",
      action: "stimulus#open"
    }
  %>
</div>

<%= search_form_for @q, data: { turbo_frame: :results, turbo_action: :advance }, id: :form_search do |f| %>

  <%= f.label :name_cont %>
  <%= f.search_field :name_cont, oninput: "this.form.requestSubmit();" %>

  <%#= f.submit class: "is-hidden" %>
<% end %>

<div class="columns">
  <div class="column">
    <%= label :q, :birth_gteq %>
    <%= date_field :q, :birth_gteq, oninput: "this.form.requestSubmit();", form: :form_search %>

    <%= label :q, :birth_lteq %>
    <%= date_field :q, :birth_lteq, oninput: "this.form.requestSubmit();", form: :form_search %>

    <%= label :q, :gender_in %>
    <% Person.genders.each do |key, value| %>
      <div>
        <%= check_box :q, :gender_in, { multiple: true, onclick: "this.form.requestSubmit();", form: :form_search }, value, nil %>
        <%= key %>
      </div>
    <% end %>

    <%= label :q, :alive_eq %>
    <%= label :q, :alive_eq, "All" %>
    <%= radio_button :q, :alive_eq, nil, onchange: "this.form.requestSubmit();", form: :form_search %>
    <%= label :q, :alive_eq, "True" %>
    <%= radio_button :q, :alive_eq, true, onchange: "this.form.requestSubmit();", form: :form_search %>
    <%= label :q, :alive_eq, "False" %>
    <%= radio_button :q, :alive_eq, false, onchange: "this.form.requestSubmit();", form: :form_search %>

    <%= label :q, :description_cont %>
    <%= search_field :q, :description_cont, oninput: "this.form.requestSubmit();", form: :form_search %>

  </div>
  <div class="column">
    <%= turbo_frame_tag "results", data: { turbo_action: :advance } do %>

      <%== pagy_bulma_nav(@pagy) %>
      <table class="table">
        <thead>
          <tr>
            <th><%= sort_link(@q, :name, 'Name', default_order: :asc) %></th>
            <th><%= sort_link(@q, :gender, 'Gender') %></th>
            <th><%= sort_link(@q, :birth, 'Birth') %></th>
            <th><%= sort_link(@q, :death, 'Death') %></th>
            <th><%= sort_link(@q, :alive, 'Alive') %></th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody id="people">
          <%= render "people/table", people: @people %>
        </tbody>
      </table>

    <% end %>
  </div>
</div>

<%= render "shared/modal", tag_name: "new_person", modal_id: "person_new" %>
