<div class='is-flex is-align-items-center mb-4'>
  <h1 class='title has-text-info m-0'><%= t('.family_tree') %></h1>
  <% if policy(@people).new? %>
    <%= link_to icon('fa-solid fa-xl', 'user-plus', class: 'has-text-success ml-4'),
      new_person_path,
      data: {
        turbo_frame: 'new_person',
        controller: 'stimulus',
        stimulus_id_value: 'person_new',
        action: 'stimulus#open'
      },
      title: t('helpers.submit.create', model: t('people.form.person'))
    %>
  <% end %>
</div>

<%= search_form_for @q, data: { turbo_frame: :results, turbo_action: :advance }, id: :form_search, class: 'mb-4' do |f| %>
  <div class='field'>
    <%= f.label :name_cont, t('.search_by_name'), class: 'label' %>
    <div class='control has-icons-left'>
      <%= f.search_field :name_cont, oninput: 'this.form.requestSubmit();', class: 'input' %>
      <span class='icon is-small is-left'>
        <i class='fas fa-magnifying-glass'></i>
      </span>
    </div>
  </div>
<% end %>

<div class='columns is-mobile custom-columns'>
  <div class='column is-narrow first-column'>
    <%= label :q, :birth_year_gteq, "#{t('.birth_year')}", class: 'label' %>
    <div class='field columns'>
      <div class='control column is-one-fifth'>
        <%= search_field :q, :birth_year_gteq, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.gteq') %>
      </div>
      <div class='control column is-one-fifth'>
        <%= search_field :q, :birth_year_lteq, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.lteq') %>
      </div>
    </div>

    <%= label :q, :birth_month_gteq, "#{t('.birth_month')}", class: 'label' %>
    <div class='field columns'>
      <div class='control column is-one-fifth'>
        <%= search_field :q, :birth_month_gteq, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.gteq') %>
      </div>
      <div class='control column is-one-fifth'>
        <%= search_field :q, :birth_month_lteq, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.lteq') %>
      </div>
    </div>

    <%= label :q, :birth_day_gteq, "#{t('.birth_day')}", class: 'label' %>
    <div class='field columns'>
      <div class='control column is-one-fifth'>
        <%= search_field :q, :birth_day_gteq, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.gteq') %>
      </div>
      <div class='control column is-one-fifth'>
        <%= search_field :q, :birth_day_lteq, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.lteq') %>
      </div>
    </div>

    <div class='field'>
      <%= label :q, :gender_in, t('people.form.gender'), class: 'label' %>
      <% Person.genders.each do |key, value| %>
        <div class='control'>
          <%= check_box :q, :gender_in, { multiple: true, onclick: 'this.form.requestSubmit();', form: :form_search }, value, nil %>
          <%= t(".#{key}") %>
        </div>
      <% end %>
    </div>

    <div class='field'>
      <%= label :q, :alive_eq, t('people.form.alive'), class: 'label' %>
      <div class='control'>
        <% %w[nil true false].each do |value| %>
          <%= radio_button :q, :alive_eq, eval(value), onchange: 'this.form.requestSubmit();', form: :form_search %>
          <%= label :q, :alive_eq, t(".#{value}") %><br>
        <% end %>
      </div>
    </div>

    <div class='field'>
      <%= label :q, :description_cont, t('people.form.remark'), class: 'label' %>
      <div class='control'>
        <%= search_field :q, :description_cont, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input' %>
      </div>
    </div>

  </div>
  <div class='column second-column'>
    <%= turbo_frame_tag 'results', data: { turbo_action: :advance } do %>

      <table class='table'>
        <thead>
          <tr>
            <th><%= sort_link(@q, :name, t('people.form.name'), default_order: :asc) %></th>
            <th class='is-hidden-touch'><%= sort_link(@q, :birth, t('people.birthday')) %></th>
            <th class='is-hidden-touch'><%= sort_link(@q, :death, t('people.form.death')) %></th>
            <th class='is-hidden-touch'><%= sort_link(@q, :alive, t('people.form.alive')) %></th>
            <th class='is-hidden-touch'><%= t('people.form.remark') %></th>
          </tr>
        </thead>
        <tbody id='people'>
          <%= render 'people/table', people: @people %>
        </tbody>
      </table>

      <%== pagy_bulma_nav(@pagy) %>

    <% end %>
  </div>
</div>

<%= render 'shared/modal', tag_name: 'new_person', modal_id: 'person_new' %>
