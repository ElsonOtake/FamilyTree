<!-- Hero Header -->
<section class='hero is-info is-small mb-5'>
  <div class='hero-body px-3 py-4 px-6-tablet py-5-tablet'>
    <div class='has-text-centered has-text-left-tablet' style='max-width: 100%;'>
      <h1 class='title is-4-mobile is-2-tablet has-text-white mb-2' style='word-break: break-word; overflow-wrap: anywhere;'>
        <span class='icon-text is-inline-flex is-align-items-center is-justify-content-center is-justify-content-start-tablet is-flex-wrap-wrap'>
          <span class='icon'>
            <i class='fas fa-tree'></i>
          </span>
          <span style='display: inline-block; line-height: 1.4;'><%= t('.family_tree') %></span>
        </span>
      </h1>
      <p class='subtitle is-6-mobile is-4-tablet has-text-white-ter has-text-centered has-text-left-tablet my-1'>
        <%= t('.search_by_name') %>
      </p>
    </div>
    <% if policy(@people).new? %>
      <div class='has-text-centered has-text-left-tablet mt-3'>
        <%= link_to new_person_path,
          class: 'button is-success is-small is-medium-tablet',
          data: {
            turbo_frame: 'new_person',
            controller: 'stimulus',
            stimulus_id_value: 'person_new',
            action: 'stimulus#open'
          },
          title: t('helpers.submit.create', model: t('people.form.person')) do %>
          <span class='icon'>
            <i class='fas fa-user-plus'></i>
          </span>
          <span><%= t('helpers.submit.create', model: t('people.form.person')) %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<!-- Search Bar -->
<div class='box mb-5'>
  <%= search_form_for @q, data: { turbo_frame: :results, turbo_action: :advance }, id: :form_search do |f| %>
    <div class='field'>
      <div class='control has-icons-left has-icons-right is-large'>
        <%= f.search_field :name_cont, 
          oninput: 'this.form.requestSubmit();', 
          class: 'input is-large', 
          placeholder: t('.search_by_name') %>
        <span class='icon is-left is-large'>
          <i class='fas fa-magnifying-glass'></i>
        </span>
      </div>
    </div>
  <% end %>
</div>

<div class='columns'>
  <!-- Filters Sidebar -->
  <div class='column is-12-mobile is-3-tablet'>
    <div class='box'>
      <h3 class='title is-5 mb-4'>
        <span class='icon-text'>
          <span class='icon has-text-info'>
            <i class='fas fa-filter'></i>
          </span>
          <span>Filters</span>
        </span>
      </h3>
      
      <!-- Birth Year Filter -->
      <div class='field mb-4'>
        <%= label :q, :birth_year_gteq, t('.birth_year'), class: 'label is-small' %>
        <div class='field is-grouped'>
          <div class='control is-expanded'>
            <%= search_field :q, :birth_year_gteq, 
              oninput: 'this.form.requestSubmit();', 
              form: :form_search, 
              class: 'input is-small', 
              placeholder: t('.gteq') %>
          </div>
          <div class='control is-expanded'>
            <%= search_field :q, :birth_year_lteq, 
              oninput: 'this.form.requestSubmit();', 
              form: :form_search, 
              class: 'input is-small', 
              placeholder: t('.lteq') %>
          </div>
        </div>
      </div>

      <!-- Birth Month Filter -->
      <div class='field mb-4'>
        <%= label :q, :birth_month_gteq, t('.birth_month'), class: 'label is-small' %>
        <div class='field is-grouped'>
          <div class='control is-expanded'>
            <%= search_field :q, :birth_month_gteq, 
              oninput: 'this.form.requestSubmit();', 
              form: :form_search, 
              class: 'input is-small', 
              placeholder: t('.gteq') %>
          </div>
          <div class='control is-expanded'>
            <%= search_field :q, :birth_month_lteq, 
              oninput: 'this.form.requestSubmit();', 
              form: :form_search, 
              class: 'input is-small', 
              placeholder: t('.lteq') %>
          </div>
        </div>
      </div>

      <!-- Birth Day Filter -->
      <div class='field mb-4'>
        <%= label :q, :birth_day_gteq, t('.birth_day'), class: 'label is-small' %>
        <div class='field is-grouped'>
          <div class='control is-expanded'>
            <%= search_field :q, :birth_day_gteq, 
              oninput: 'this.form.requestSubmit();', 
              form: :form_search, 
              class: 'input is-small', 
              placeholder: t('.gteq') %>
          </div>
          <div class='control is-expanded'>
            <%= search_field :q, :birth_day_lteq, 
              oninput: 'this.form.requestSubmit();', 
              form: :form_search, 
              class: 'input is-small', 
              placeholder: t('.lteq') %>
          </div>
        </div>
      </div>

      <!-- Gender Filter -->
      <div class='field mb-4'>
        <%= label :q, :gender_in, t('people.form.gender'), class: 'label is-small' %>
        <% Person.genders.each do |key, value| %>
          <div class='field'>
            <div class='control'>
              <label class='checkbox'>
                <%= check_box :q, :gender_in, 
                  { multiple: true, onclick: 'this.form.requestSubmit();', form: :form_search, class: 'mr-2' }, 
                  value, nil %>
                <%= t(".#{key}") %>
              </label>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Alive Status Filter -->
      <div class='field mb-4'>
        <%= label :q, :alive_eq, t('people.form.alive'), class: 'label is-small' %>
        <% %w[nil true false].each do |value| %>
          <div class='field'>
            <div class='control'>
              <label class='radio'>
                <%= radio_button :q, :alive_eq, eval(value), 
                  onchange: 'this.form.requestSubmit();', 
                  form: :form_search,
                  class: 'mr-2' %>
                <%= t(".#{value}") %>
              </label>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Remark Filter -->
      <div class='field'>
        <%= label :q, :description_cont, t('people.form.remark'), class: 'label is-small' %>
        <div class='control'>
          <%= search_field :q, :description_cont, 
            oninput: 'this.form.requestSubmit();', 
            form: :form_search, 
            class: 'input is-small',
            placeholder: t('people.form.remark') %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Results Section -->
  <div class='column is-9'>
    <div class='box'>
      <%= turbo_frame_tag 'results', data: { turbo_action: :advance } do %>
        <div class='table-container'>
          <table class='table is-fullwidth is-hoverable is-striped'>
            <thead>
              <tr>
                <th>
                  <span class='icon-text'>
                    <span class='icon has-text-info'>
                      <i class='fas fa-user'></i>
                    </span>
                    <span><%= sort_link(@q, :name, t('people.form.name'), default_order: :asc) %></span>
                  </span>
                </th>
                <th class='is-hidden-touch'>
                  <span class='icon-text'>
                    <span class='icon has-text-success'>
                      <i class='fas fa-birthday-cake'></i>
                    </span>
                    <span><%= sort_link(@q, :birth, t('people.birthday')) %></span>
                  </span>
                </th>
                <th class='is-hidden-touch'>
                  <span class='icon-text'>
                    <span class='icon has-text-grey'>
                      <i class='fas fa-cross'></i>
                    </span>
                    <span><%= sort_link(@q, :death, t('people.form.death')) %></span>
                  </span>
                </th>
                <th class='is-hidden-touch'>
                  <span class='icon-text'>
                    <span class='icon has-text-primary'>
                      <i class='fas fa-heartbeat'></i>
                    </span>
                    <span><%= sort_link(@q, :alive, t('people.form.alive')) %></span>
                  </span>
                </th>
                <th class='is-hidden-touch'>
                  <span class='icon-text'>
                    <span class='icon has-text-warning'>
                      <i class='fas fa-comment'></i>
                    </span>
                    <span class="has-text-grey"><%= t('people.form.remark') %></span>
                  </span>
                </th>
                <th>
                  <span class='icon-text'>
                    <span class='icon has-text-danger'>
                      <i class='fas fa-heart'></i>
                    </span>
                    <span class="has-text-grey"><%= t('favorites.title') %></span>
                  </span>
                </th>
              </tr>
            </thead>
            <tbody id='people'>
              <%= render 'people/table', people: @people %>
            </tbody>
          </table>
        </div>
        
        <div class='mt-4'>
          <%== pagy_bulma_nav(@pagy) %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'shared/modal', tag_name: 'new_person', modal_id: 'person_new' %>
