<h1 class="title has-text-info">Family Tree</h1>

<div class="buttons are-small box">
  <% @first.each do |letter| %>
    <%= form_with url: search_users_first_letter_path, method: :post do |form| %>
      <%= form.hidden_field :letter, value: letter.initial %>
      <%= form.submit letter.initial,
        data: {
          controller: "stimulus",
          action: "stimulus#select"
        },
        class: "first-letter-button button is-rounded"
      %>
    <% end  %>
  <% end %>
</div>

<ul id="people" class="box">
  <%= render "people/list", people: @people %>
</ul>

<%#= link_to "New person", new_person_path %>
