<h1 class="title has-text-info">Family Tree</h1>

<div class="buttons are-small box">
  <% @first.each do |letter| %>
    <%= link_to letter.initial, nil, class: "button is-rounded" %>
  <% end %>
</div>

<ul id="people" class="box">
  <% @people.each do |person| %>
    <li class="mb-2">
      <%= render "icon", variable: person %><%= link_to person.name, person_path(person) %>
    </li>
  <% end %>
</ul>

<%#= link_to "New person", new_person_path %>
