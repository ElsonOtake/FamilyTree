<%# Hero header %>
<section class='mb-6 rounded-2xl bg-linear-to-r from-brand-600 to-brand-500 px-6 py-6 text-white shadow-sm sm:flex sm:items-center sm:justify-between'>
  <div>
    <h1 class='flex items-center gap-2 text-2xl font-bold sm:text-3xl'>
      <%= heroicon(:user_group, class: 'size-7') %>
      <%= t('.family_tree') %>
    </h1>
    <p class='mt-1 text-sm text-white/80'><%= t('.search_by_name') %></p>
  </div>
  <% if policy(@people).new? %>
    <div class='mt-4 sm:mt-0'>
      <%= link_to new_person_path,
        class: 'btn btn-secondary',
        data: { turbo_frame: 'new_person', controller: 'stimulus', stimulus_id_value: 'person_new', action: 'stimulus#open' },
        title: t('helpers.submit.create', model: t('people.form.person')) do %>
        <%= heroicon(:user_plus, class: 'size-5') %>
        <span><%= t('helpers.submit.create', model: t('people.form.person')) %></span>
      <% end %>
    </div>
  <% end %>
</section>

<%# Search bar %>
<div class='card mb-6'>
  <div class='card-body'>
    <%= search_form_for @q, data: { turbo_frame: :results, turbo_action: :advance }, id: :form_search do |f| %>
      <div class='relative'>
        <span class='pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400'>
          <%= heroicon(:magnifying_glass, class: 'size-5') %>
        </span>
        <%= f.search_field :name_cont, oninput: 'this.form.requestSubmit();',
          class: 'input pl-10 text-lg', placeholder: t('.search_by_name') %>
      </div>
    <% end %>
  </div>
</div>

<div class='grid grid-cols-1 gap-6 lg:grid-cols-4'>
  <%# Filters sidebar %>
  <aside class='lg:col-span-1'>
    <div class='card'>
      <div class='card-body space-y-5'>
        <h3 class='card-title'>
          <%= heroicon(:funnel, class: 'size-5 text-brand-500') %><%= t('.filters') %>
        </h3>

        <% [[:birth_year, '.birth_year'], [:birth_month, '.birth_month'], [:birth_day, '.birth_day']].each do |attr, key| %>
          <div>
            <%= label :q, :"#{attr}_gteq", t(key), class: 'label text-xs' %>
            <div class='flex gap-2'>
              <%= search_field :q, :"#{attr}_gteq", oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.gteq') %>
              <%= search_field :q, :"#{attr}_lteq", oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('.lteq') %>
            </div>
          </div>
        <% end %>

        <div>
          <span class='label text-xs'><%= t('people.form.gender') %></span>
          <div class='space-y-1'>
            <% Person.genders.each do |key, value| %>
              <label class='flex items-center gap-2 text-sm'>
                <%= check_box :q, :gender_in, { multiple: true, onclick: 'this.form.requestSubmit();', form: :form_search, class: 'rounded border-slate-300 text-brand-500 focus:ring-brand-400' }, value, nil %>
                <%= t(".#{key}") %>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <span class='label text-xs'><%= t('people.form.alive') %></span>
          <div class='space-y-1'>
            <% %w[nil true false].each do |value| %>
              <label class='flex items-center gap-2 text-sm'>
                <%= radio_button :q, :alive_eq, eval(value), onchange: 'this.form.requestSubmit();', form: :form_search, class: 'border-slate-300 text-brand-500 focus:ring-brand-400' %>
                <%= t(".#{value}") %>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <%= label :q, :description_cont, t('people.form.remark'), class: 'label text-xs' %>
          <%= search_field :q, :description_cont, oninput: 'this.form.requestSubmit();', form: :form_search, class: 'input', placeholder: t('people.form.remark') %>
        </div>
      </div>
    </div>
  </aside>

  <%# Results %>
  <div class='lg:col-span-3'>
    <div class='card'>
      <div class='card-body'>
        <%= turbo_frame_tag 'results', data: { turbo_action: :advance } do %>
          <div class='overflow-x-auto'>
            <table class='w-full text-left text-sm'>
              <thead class='border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700'>
                <tr>
                  <th class='py-2 pr-3'><%= sort_link(@q, :name, t('people.form.name'), default_order: :asc) %></th>
                  <th class='hidden py-2 pr-3 md:table-cell'><%= sort_link(@q, :birth, t('people.birthday')) %></th>
                  <th class='hidden py-2 pr-3 md:table-cell'><%= sort_link(@q, :death, t('people.form.death')) %></th>
                  <th class='hidden py-2 pr-3 md:table-cell'><%= sort_link(@q, :alive, t('people.form.alive')) %></th>
                  <th class='hidden py-2 pr-3 lg:table-cell'><%= t('people.form.remark') %></th>
                  <th class='py-2 text-right'><%= t('favorites.title') %></th>
                </tr>
              </thead>
              <tbody id='people' class='divide-y divide-slate-100 dark:divide-slate-700'>
                <%= render 'people/table', people: @people %>
              </tbody>
            </table>
          </div>

          <div class='mt-4'>
            <%== pagy_nav(@pagy) %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render 'shared/modal', tag_name: 'new_person', modal_id: 'person_new' %>
