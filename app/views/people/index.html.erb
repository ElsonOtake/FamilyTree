<div class="is-flex is-align-items-center mb-4">
  <h1 class="title has-text-info m-0">Family Tree</h1>
  <%= link_to icon('fa-solid fa-xl', 'user-plus', class: 'has-text-primary ml-4'), new_person_path %>
</div>

<p class="has-text-link has-text-weight-semibold">Search by</p>
<div class="box">
  <div class="columns">
    <div class="column">
      <p class="has-text-link has-text-weight-semibold">Name</p>
      <div class="box">
        <%= form_with url: search_users_name_path, method: :post do |form| %>
          <div class="field has-addons">
            <div class="control">
              <%= form.text_field :name, class: "input is-info is-rounded", placeholder: "Search by name" %>
            </div>

            <div class="control">
              <%= form.submit "Search", class: "button is-info is-rounded" %>
            </div>
          </div>
        <% end  %>
      </div>
    </div>
    <div class="column">
      <p class="has-text-link has-text-weight-semibold">Initial</p>
      <div class="buttons are-small box">
        <% first_one = true %>
        <% @first.each do |letter| %>
          <%= form_with url: search_users_first_letter_path, method: :post do |form| %>
            <%= form.hidden_field :letter, value: letter.initial %>
            <% if first_one %>
              <%= form.submit letter.initial,
                data: {
                  controller: "stimulus",
                  action: "stimulus#select"
                },
                class: "first-letter-button button is-rounded is-info"
              %>
              <% first_one = false %>
            <% else %>
              <%= form.submit letter.initial,
                data: {
                  controller: "stimulus",
                  action: "stimulus#select"
                },
                class: "first-letter-button button is-rounded"
              %>
            <% end %>
          <% end  %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<ul id="people" class="box">
  <%= render "people/list", people: @people %>
</ul>
