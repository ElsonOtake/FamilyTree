<h1>Family Tree</h1>

<% @first.each do |letter| %>
  <span><a class="button is-small"><%= letter.initial %></a></span>
<% end %>

<div id="people">
  <table class="table">
    <tbody>
      <% @people.each do |person| %>
        <tr>
          <td>
            <%= render "icon", variable: person %>
          </td>
          <td>
            <%= link_to person.name, person_path(person) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New person", new_person_path %>
