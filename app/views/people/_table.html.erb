<%= turbo_frame_tag 'table' do %>
  <% people.each do |person| %>
    <tr>
      <td>
        <%= render 'people/icon', person: %>&nbsp;
        <%= link_to person_path(person), data: { turbo_frame: '_top' } do %>
          <%= highlight person.name, params.dig(:q, :name_cont) %>
        <% end %>
      </td>
      <td class='is-hidden-touch'><%= person.birth_date_formatted %></td>
      <td class='is-hidden-touch'><%= person.death_date_formatted %></td>
      <td class='is-hidden-touch'><%= t("people.index.#{person.alive}") %></td>
      <td class='is-hidden-touch'><%= highlight person.description, params.dig(:q, :description_cont) %></td>
      <td>
        <% favorite = current_user.favorites.find_by(person: person) %>
        <% if favorite %>
          <%= button_to person_favorite_path(person, favorite), 
            method: :delete,
            remote: true,
            data: { 
              controller: 'favorites',
              action: 'click->favorites#toggle'
            },
            class: 'button is-small is-danger',
            title: t('favorites.remove') do %>
            <span class='icon'>
              <i class='fas fa-heart'></i>
            </span>
          <% end %>
        <% else %>
          <%= button_to person_favorites_path(person), 
            remote: true,
            data: { 
              controller: 'favorites',
              action: 'click->favorites#toggle'
            },
            class: 'button is-small is-light',
            title: t('favorites.add') do %>
            <span class='icon'>
              <i class='far fa-heart'></i>
            </span>
          <% end %>
        <% end %>
      </td>
    </tr>
  <% end %>
<% end %>