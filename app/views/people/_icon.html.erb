<%= icon('fa-solid', 'mars', class: "has-text-info") if variable.gender == "M" %>
<%= icon('fa-solid', 'venus', class: "has-text-danger") if variable.gender == "F" %>
<%= icon('fa-solid', 'mars-and-venus', class: "has-text-primary") if variable.gender == "X" %>
<%= icon('fa-solid', 'dog', class: "has-text-warning") if variable.gender == "P" %>