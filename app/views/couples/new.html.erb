<%= turbo_frame_tag 'new_couple' do %>
  <h1 class='mb-4 text-xl font-bold text-slate-800 dark:text-slate-100'>
    <%= t('helpers.submit.create', model: t('people.show.mate')) %> — <%= @person.name %>
  </h1>

  <div data-controller='tabs'>
    <div class='mb-4 flex gap-1 border-b border-slate-200 dark:border-slate-700'>
      <button type='button' data-tabs-target='tab' data-tabs-panel-param='new-mate' data-action='tabs#select'
              class='flex items-center gap-1.5 border-b-2 border-brand-500 px-3 py-2 text-sm font-medium text-brand-600'>
        <%= heroicon(:user_plus, class: 'size-4') %><%= t('couples.form.new_partner') %>
      </button>
      <button type='button' data-tabs-target='tab' data-tabs-panel-param='existing-mate' data-action='tabs#select'
              class='flex items-center gap-1.5 border-b-2 border-transparent px-3 py-2 text-sm font-medium text-slate-500'>
        <%= heroicon(:user, class: 'size-4') %><%= t('couples.form.existing_partner') %>
      </button>
    </div>

    <div data-tabs-target='panel' data-tabs-panel='new-mate'>
      <%= render 'people/form', person: Person.new, couple: nil, mate: @couple.person1_id %>
    </div>
    <div data-tabs-target='panel' data-tabs-panel='existing-mate' class='hidden'>
      <%= render 'form', couple: @couple, url: person_couples_path(@person) %>
    </div>
  </div>
<% end %>
