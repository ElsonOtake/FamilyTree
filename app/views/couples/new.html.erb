<%= turbo_frame_tag 'new_couple' do %>
  <h1 class='mb-4 text-xl font-bold text-slate-800 dark:text-slate-100'>
    <%= t('helpers.submit.create', model: t('people.show.mate')) %> — <%= @person.name %>
  </h1>

  <div data-controller='source-toggle'>
    <fieldset class='mb-4'>
      <legend class='mb-2 text-sm font-medium text-slate-600 dark:text-slate-300'>
        <%= t('couples.form.choose_source') %>
      </legend>
      <div class='grid grid-cols-2 gap-2'>
        <label class='flex cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-500 transition has-checked:border-brand-500 has-checked:bg-brand-50 has-checked:text-brand-600 dark:border-slate-700 dark:has-checked:border-brand-500 dark:has-checked:bg-brand-900/20'>
          <input type='radio' name='mate_source' value='new' checked class='sr-only' data-action='change->source-toggle#select'>
          <%= heroicon(:user_plus, class: 'size-4') %><%= t('couples.form.new_partner') %>
        </label>
        <label class='flex cursor-pointer items-center justify-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-500 transition has-checked:border-brand-500 has-checked:bg-brand-50 has-checked:text-brand-600 dark:border-slate-700 dark:has-checked:border-brand-500 dark:has-checked:bg-brand-900/20'>
          <input type='radio' name='mate_source' value='existing' class='sr-only' data-action='change->source-toggle#select'>
          <%= heroicon(:user, class: 'size-4') %><%= t('couples.form.existing_partner') %>
        </label>
      </div>
    </fieldset>

    <div data-source-toggle-target='panel' data-source='new'>
      <%= render 'people/form', person: Person.new, couple: nil, mate: @couple.person1_id %>
    </div>
    <div data-source-toggle-target='panel' data-source='existing' class='hidden'>
      <%= render 'form', couple: @couple, url: person_couples_path(@person) %>
    </div>
  </div>
<% end %>
