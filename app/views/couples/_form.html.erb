<%= render 'people/search_mate_name' unless couple.persisted? %>
<% mate_name = if couple.persisted?
                 (couple.person1_id == @person.id ? Person.find(couple.person2_id) : Person.find(couple.person1_id)).name
               else
                 ''
               end %>

<%= form_with model: couple, url: url, data: { controller: 'stimulus', action: 'turbo:submit-end->stimulus#submitEnd' } do |form| %>
  <% if couple.errors.any? %>
    <div class='mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-200 dark:bg-red-900/30 dark:text-red-200'>
      <h2 class='mb-1 font-semibold'><%= t('errors.template.header', count: couple.errors.count, model: t('people.show.mate')) %></h2>
      <ul class='list-inside list-disc'>
        <% couple.errors.each do |error| %><li><%= error.full_message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :person1_id if couple.person1_id == @person.id %>
  <%= form.hidden_field :person2_id if couple.person2_id == @person.id %>

  <div class='space-y-5'>
    <div class='field'>
      <%= form.label :mate, t('people.show.mate'), class: 'label' %>
      <%= form.number_field :person1_id, class: 'hidden' if couple.person2_id == @person.id %>
      <%= form.number_field :person2_id, class: 'hidden' if couple.person1_id == @person.id %>
      <%= form.text_field :name, class: 'input', disabled: true, value: mate_name,
          placeholder: couple.persisted? ? '' : t('couples.form.select_partner') %>
      <% unless couple.persisted? %>
        <p class='mt-1 text-xs text-slate-400'><%= t('couples.form.search_partner_help') %></p>
      <% end %>
    </div>

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
      <div class='field'>
        <%= form.label :marriage, t('.marriage'), class: 'label' %>
        <%= form.date_field :marriage, class: 'input' %>
      </div>
      <div class='field'>
        <%= form.label :separation, t('.separation'), class: 'label' %>
        <%= form.date_field :separation, class: 'input' %>
      </div>
    </div>

    <div class='field'>
      <%= form.label :local, t('.local'), class: 'label' %>
      <%= form.text_area :local, class: 'input', rows: 3, placeholder: t('couples.form.location_placeholder') %>
    </div>
  </div>

  <div class='mt-6 flex justify-center gap-3'>
    <%= form.submit(couple.persisted? ? t('couples.form.update_couple') : t('couples.form.create_couple'),
        class: 'btn btn-primary cursor-pointer', disabled: !couple.persisted?, id: 'submit-button') %>
    <%= link_to t(:back), nil, data: { controller: 'stimulus', action: 'stimulus#closeAllModals' }, class: 'btn btn-secondary' %>
  </div>
<% end %>
