<%= turbo_frame_tag 'edit_couple' do %>
  <h1 class='mb-4 text-xl font-bold text-slate-800 dark:text-slate-100'>
    <%= t('helpers.submit.edit', model: t('people.show.mate')) %> — <%= @person.name %>
  </h1>

  <%= render 'form', couple: @couple, url: person_couple_path(@person, @couple), mate: nil %>
<% end %>
