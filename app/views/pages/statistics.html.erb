<section class='mb-8 rounded-2xl bg-linear-to-r from-brand-600 to-brand-500 px-6 py-8 text-center text-white shadow-sm'>
  <h1 class='flex items-center justify-center gap-2 text-3xl font-bold sm:text-4xl'>
    <%= heroicon(:chart_bar, class: 'size-8') %><%= t('.title') %>
  </h1>
  <p class='mx-auto mt-2 max-w-2xl text-white/80'><%= t('.description') %></p>
</section>

<div class='mx-auto max-w-5xl space-y-10'>
  <%# Overview %>
  <div>
    <h2 class='mb-4 text-center text-xl font-bold text-slate-800 dark:text-slate-100'><%= t('.overview') %></h2>
    <div class='grid grid-cols-2 gap-4 lg:grid-cols-4'>
      <% [[:users, 'text-brand-500', @total_people, '.total_people'],
          [:heart, 'text-female', @total_couples, '.total_couples'],
          [:heart_pulse, 'text-emerald-500', @living_people, '.living_people'],
          [:clock, 'text-slate-400', @deceased_people, '.deceased_people']].each do |icon, color, value, key| %>
        <div class='card'>
          <div class='card-body text-center'>
            <%= heroicon(icon, class: "mx-auto size-8 #{color}") %>
            <p class='mt-2 text-3xl font-bold <%= color %>'><%= value %></p>
            <p class='text-sm text-slate-500'><%= t(key) %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Gender distribution %>
  <div>
    <h2 class='mb-4 text-center text-xl font-bold text-slate-800 dark:text-slate-100'><%= t('.gender_distribution') %></h2>
    <% gender_styles = { 'M' => ['text-male', 'bg-blue-500'], 'F' => ['text-female', 'bg-pink-500'],
                         'P' => ['text-pet', 'bg-amber-500'], 'X' => ['text-other', 'bg-violet-500'] } %>
    <div class='grid grid-cols-2 gap-4 lg:grid-cols-4'>
      <% @people_by_gender.each do |gender, count| %>
        <% text_color, bar_color = gender_styles[gender.to_s.upcase] || ['text-slate-400', 'bg-slate-400'] %>
        <% pct = @total_people.positive? ? ((count.to_f / @total_people) * 100).round(1) : 0 %>
        <div class='card'>
          <div class='card-body text-center'>
            <%= heroicon(:user, class: "mx-auto size-7 #{text_color}") %>
            <p class='mt-2 text-2xl font-bold text-slate-800 dark:text-slate-100'><%= count %></p>
            <p class='text-sm text-slate-500'><%= t(".gender_#{gender&.downcase || 'unknown'}") %></p>
            <div class='mt-2 h-2 w-full rounded-full bg-slate-100 dark:bg-slate-700'>
              <div class='h-2 rounded-full <%= bar_color %>' style='width: <%= pct %>%'></div>
            </div>
            <p class='mt-1 text-xs text-slate-400'><%= pct %>%</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Birth decades %>
  <% unless @birth_year_stats.empty? %>
    <div>
      <h2 class='mb-4 text-center text-xl font-bold text-slate-800 dark:text-slate-100'><%= t('.birth_decades') %></h2>
      <div class='card'>
        <div class='card-body overflow-x-auto'>
          <table class='w-full text-left text-sm'>
            <thead class='border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700'>
              <tr>
                <th class='py-2 pr-3'><%= t('.decade') %></th>
                <th class='py-2 pr-3'><%= t('.people_count') %></th>
                <th class='py-2'><%= t('.percentage') %></th>
              </tr>
            </thead>
            <tbody class='divide-y divide-slate-100 dark:divide-slate-700'>
              <% max = @birth_year_stats.values.max %>
              <% total = @birth_year_stats.values.sum %>
              <% @birth_year_stats.each do |decade, count| %>
                <% pct = total.positive? ? ((count.to_f / total) * 100).round(1) : 0 %>
                <tr>
                  <td class='py-2 pr-3 font-semibold'><%= decade %>s</td>
                  <td class='py-2 pr-3'><span class='badge bg-brand-100 text-brand-700 dark:bg-brand-900/40 dark:text-brand-200'><%= count %></span></td>
                  <td class='py-2'>
                    <div class='flex items-center gap-2'>
                      <div class='h-2 w-32 rounded-full bg-slate-100 dark:bg-slate-700'>
                        <div class='h-2 rounded-full bg-emerald-500' style='width: <%= max.positive? ? (count.to_f / max * 100).round : 0 %>%'></div>
                      </div>
                      <span class='text-xs text-slate-400'><%= pct %>%</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <%# Family structure %>
  <div>
    <h2 class='mb-4 text-center text-xl font-bold text-slate-800 dark:text-slate-100'><%= t('.family_structure') %></h2>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-3'>
      <% [[:user, 'text-amber-500', @people_without_parents, '.without_parents'],
          [:user_plus, 'text-emerald-500', @people_with_children, '.with_children'],
          [:user, 'text-brand-500', @people_without_children, '.without_children']].each do |icon, color, value, key| %>
        <div class='card'>
          <div class='card-body text-center'>
            <%= heroicon(icon, class: "mx-auto size-7 #{color}") %>
            <p class='mt-2 text-2xl font-bold <%= color %>'><%= value %></p>
            <p class='text-sm text-slate-500'><%= t(key) %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
