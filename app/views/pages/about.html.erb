<section class='mb-8 rounded-2xl bg-linear-to-r from-brand-600 to-brand-500 px-6 py-10 text-center text-white shadow-sm'>
  <%= image_tag 'EAO.png', alt: 'Family Tree', class: 'mx-auto mb-4 size-28 rounded-full shadow-md' %>
  <h1 class='text-3xl font-bold sm:text-4xl'><%= t('.title') %></h1>
  <p class='mx-auto mt-3 max-w-2xl text-white/80'><%= t('.description') %></p>
</section>

<div class='mx-auto max-w-4xl'>
  <h2 class='mb-6 flex items-center justify-center gap-2 text-2xl font-bold text-slate-800 dark:text-slate-100'>
    <%= heroicon(:information_circle, class: 'size-6 text-brand-500') %><%= t('.guide_heading') %>
  </h2>

  <div class='grid grid-cols-1 gap-4 md:grid-cols-2'>
    <% [[:magnifying_glass, 'text-brand-500', 'search'],
        [:user_plus, 'text-emerald-500', 'people'],
        [:user_group, 'text-blue-500', 'relationships'],
        [:heart, 'text-female', 'favorites'],
        [:cake, 'text-amber-500', 'birthdays'],
        [:document_arrow_down, 'text-brand-500', 'descendants_full'],
        [:document_text, 'text-blue-500', 'descendants'],
        [:users, 'text-brand-600', 'ancestors'],
        [:adjustments_horizontal, 'text-violet-500', 'tree_settings'],
        [:shield_check, 'text-emerald-600', 'approval'],
        [:globe_alt, 'text-slate-500', 'languages']].each do |icon, color, key| %>
      <div class='card'>
        <div class='card-body'>
          <h3 class='mb-2 flex items-center gap-2 font-semibold text-slate-800 dark:text-slate-100'>
            <span class='flex size-9 shrink-0 items-center justify-center rounded-lg bg-slate-50 dark:bg-slate-700 <%= color %>'>
              <%= heroicon(icon, class: 'size-5') %>
            </span>
            <%= t(".guide_#{key}_title") %>
          </h3>
          <p class='text-sm leading-relaxed text-slate-600 dark:text-slate-300'><%= t(".guide_#{key}_body") %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class='mx-auto mt-8 max-w-xl'>
    <div class='card'>
      <div class='card-body text-center'>
        <h2 class='mb-3 flex items-center justify-center gap-2 text-xl font-bold text-slate-800 dark:text-slate-100'>
          <%= heroicon(:envelope, class: 'size-5 text-brand-500') %><%= t('.contact') %>
        </h2>
        <p class='mb-5 text-sm text-slate-500'><%= t('.contact_description') %></p>
        <%= link_to 'mailto:elsonotake@gmail.com', class: 'btn btn-primary' do %>
          <%= heroicon(:envelope, class: 'size-5') %><span><%= t('.contact_link') %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>
