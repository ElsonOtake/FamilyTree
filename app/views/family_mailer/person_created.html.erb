<h1>Created by <%= @user.name %> (<%= @user.email %>)</h1>

<table>
  <tr>
    <th>id</th>
    <td><%= @person.id %></td>
  </tr>
  <tr>
    <th>name</th>
    <td><%= @person.name %></td>
  </tr>
  <% unless @person.kanji.empty? %>
    <tr>
      <th>kanji</th>
      <td><%= @person.kanji %></td>
    </tr>
  <% end %>
  <tr>
    <th>gender</th>
    <td><%= @person.gender %></td>
  </tr>
  <tr>
    <th>alive</th>
    <td><%= @person.alive %></td>
  </tr>
  <% if @person.birth.respond_to?(:strftime) || !(@person.birth.nil? || @person.birth.empty?) %>
    <tr>
      <th>birth</th>
      <td><%= @person.birth %></td>
    </tr>
  <% end %>
  <% if @person.death.respond_to?(:strftime) || !(@person.death.nil? || @person.death.empty?) %>
    <tr>
      <th>death</th>
      <td><%= @person.death %></td>
    </tr>
  <% end %>
  <% unless @person.description.empty? %>
    <tr>
      <th>description</th>
      <td><%= @person.description %></td>
    </tr>
  <% end %>
</table>
