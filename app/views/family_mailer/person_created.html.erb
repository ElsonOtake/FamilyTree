<h1>Person created by <%= @user.name %> (<%= @user.email %>)</h1>

<table>
  <tr>
    <th>Name</th>
    <td><%= @person.name %> (<%= @person.id %>)</td>
  </tr>
  <% unless @person.kanji.empty? %>
    <tr>
      <th>Kanji</th>
      <td><%= @person.kanji %></td>
    </tr>
  <% end %>
  <tr>
    <th>Gender</th>
    <td><%= @person.gender %></td>
  </tr>
  <tr>
    <th>Alive</th>
    <td><%= @person.alive %></td>
  </tr>
  <% if @person.birth.respond_to?(:strftime) || !(@person.birth.nil? || @person.birth.empty?) %>
    <tr>
      <th>Birth</th>
      <td><%= @person.birth %></td>
    </tr>
  <% end %>
  <% if @person.death.respond_to?(:strftime) || !(@person.death.nil? || @person.death.empty?) %>
    <tr>
      <th>Death</th>
      <td><%= @person.death %></td>
    </tr>
  <% end %>
  <% unless @person.description.empty? %>
    <tr>
      <th>Description</th>
      <td><%= @person.description %></td>
    </tr>
  <% end %>
</table>
