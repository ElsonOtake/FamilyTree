<h1>Couple created by <%= @user.name %> (<%= @user.email %>)</h1>

<table>
  <tr>
    <th>id</th>
    <td><%= @couple.id %></td>
  </tr>
  <tr>
    <th>couple</th>
    <td><%= @person_1_name %> & <%= @person_2_name %></td>
  </tr>
  <% if @couple.marriage.respond_to?(:strftime) || !(@couple.marriage.nil? || @couple.marriage.empty?) %>
    <tr>
      <th>marriage</th>
      <td><%= @couple.marriage %></td>
    </tr>
  <% end %>
  <% if @couple.separation.respond_to?(:strftime) || !(@couple.separation.nil? || @couple.separation.empty?) %>
    <tr>
      <th>separation</th>
      <td><%= @couple.separation %></td>
    </tr>
  <% end %>
  <% if !(@couple.local.nil? || @couple.local.empty?) %>
    <tr>
      <th>local</th>
      <td><%= @couple.local %></td>
    </tr>
  <% end %>
</table>
