<section class='mb-6 rounded-2xl bg-linear-to-r from-brand-600 to-brand-500 px-6 py-5 text-white shadow-sm'>
  <h1 class='flex items-center gap-2 text-2xl font-bold'>
    <%= heroicon(:shield_check, class: 'size-6') %><%= t('.role') %>
  </h1>
  <p class='mt-1 text-sm text-white/80'><%= t('.manage_user_permissions') %></p>
</section>

<div class='grid grid-cols-1 gap-4 sm:grid-cols-3'>
  <% [[:users, 'text-brand-500', @users.count, '.total_users'],
      [:shield_check, 'text-emerald-500', @users.count { |u| u.has_role?(:admin) }, '.administrators'],
      [:pencil_square, 'text-blue-500', @users.count { |u| u.has_role?(:editor) }, '.editors']].each do |icon, color, value, key| %>
    <div class='card'>
      <div class='card-body flex items-center justify-between'>
        <div>
          <p class='text-xs uppercase tracking-wide text-slate-400'><%= t(key) %></p>
          <p class='text-3xl font-bold <%= color %>'><%= value %></p>
        </div>
        <%= heroicon(icon, class: "size-8 #{color}") %>
      </div>
    </div>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <div class='mt-4'><%== pagy_nav(@pagy) %></div>
<% end %>

<div class='card mt-6'>
  <div class='card-body overflow-x-auto'>
    <table class='w-full text-left text-sm'>
      <thead class='border-b border-slate-200 text-xs uppercase tracking-wide text-slate-500 dark:border-slate-700'>
        <tr>
          <th class='py-2 pr-3'><%= t('people.form.name') %></th>
          <th class='py-2 pr-3'>E-mail</th>
          <th class='py-2 pr-3'><%= t('.level') %></th>
          <th class='py-2 pr-3'><%= t('.last_access') %></th>
          <th class='py-2'><%= t('.status') %></th>
        </tr>
      </thead>
      <tbody class='divide-y divide-slate-100 dark:divide-slate-700'>
        <% @users.each do |user| %>
          <tr>
            <td class='py-2 pr-3'>
              <div class='flex items-center gap-2'>
                <% role_icon, role_color = user.has_role?(:admin) ? [:shield_check, 'text-red-500'] : user.has_role?(:editor) ? [:pencil_square, 'text-blue-500'] : [:user, 'text-slate-400'] %>
                <%= heroicon(role_icon, class: "size-5 #{role_color}") %>
                <div>
                  <p class='font-semibold'><%= user.name || t('.unnamed_user') %></p>
                  <% if user.locale.present? %>
                    <p class='text-xs text-slate-400'><%= t("locales.#{user.locale}") %></p>
                  <% end %>
                </div>
              </div>
            </td>
            <td class='py-2 pr-3'>
              <p><%= user.email %></p>
              <% if user.provider.present? %>
                <span class='badge'><%= user.provider.capitalize %></span>
              <% end %>
            </td>
            <td class='py-2 pr-3'><%= render 'form_role', user: user %></td>
            <td class='py-2 pr-3'>
              <% if user.respond_to?(:current_sign_in_at) && user.current_sign_in_at %>
                <p class='text-xs'><%= l(user.current_sign_in_at, format: :short) %></p>
                <% if user.respond_to?(:sign_in_count) %>
                  <p class='text-xs text-slate-400'><%= t('.sign_in_count', count: user.sign_in_count || 0) %></p>
                <% end %>
              <% else %>
                <span class='text-slate-400'><%= t('.never_signed_in') %></span>
              <% end %>
            </td>
            <td class='py-2'>
              <% if user.respond_to?(:confirmed_at) && user.confirmed_at %>
                <span class='badge-alive badge'><%= t('.confirmed') %></span>
              <% else %>
                <span class='badge bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-200'><%= t('.pending') %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy.pages > 1 %>
  <div class='mt-4'><%== pagy_nav(@pagy) %></div>
<% end %>
