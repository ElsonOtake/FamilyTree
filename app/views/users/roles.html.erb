<p class='title has-text-info'><%= t('.role') %></p>
<%== pagy_bulma_nav(@pagy) if @pagy.pages > 1 %>
<table class='table is-striped is-hoverable is-narrow'>
  <thead>
    <tr>
      <th class='has-text-info'><%= t('people.form.name') %></th>
      <th class='has-text-info'>E-mail</th>
      <th class='has-text-info'><%= t('.level') %></th>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= render 'form_role', user: user %></td>
      </tr>
    <% end %>
  </tbody>
</table>