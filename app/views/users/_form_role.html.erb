<%= form_with model: user, url: role_update_user_url(user) do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= t('errors.template.header', count: errors.count, model: t('.user')) %></h2>

      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.select :role, @roles, { selected: user.roles.first.name }, oninput: "this.form.requestSubmit();" %>
<% end %>
