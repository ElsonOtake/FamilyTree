<%= form_with model: user, url: role_update_user_url(user) do |form| %>
  <%= form.select :role, @roles,
      { selected: (user.has_role?(:admin) ? 'admin' : user.has_role?(:editor) ? 'editor' : user.roles.first&.name) },
      { oninput: 'this.form.requestSubmit();', class: 'input w-auto py-1 text-sm font-semibold' } %>
<% end %>
