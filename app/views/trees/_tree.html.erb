<div id="<%= dom_id tree %>">
  <p>
    <strong>Name:</strong>
    <%= tree.name %>
  </p>

  <p>
    <strong>gender:</strong>
    <%= tree.gender %>
  </p>

  <p>
    <strong>Alive:</strong>
    <%= tree.alive %>
  </p>

  <% unless tree.birth.nil? %>
    <p>
      <strong>Birth:</strong>
      <%= tree.birth %>
      <%= distance_of_time_in_words(tree.birth, Date.today) %>
    </p>
  <% end %>

  <% unless tree.death.nil? %>
    <p>
      <strong>Death:</strong>
      <%= tree.death %>
    </p>
  <% end %>

  <% unless tree.description.nil? %>
    <p>
      <%# <strong>description:</strong> %>
      <%= tree.description %>
    </p>
  <% end %>

</div>
