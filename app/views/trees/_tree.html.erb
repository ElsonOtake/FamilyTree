<div id="<%= dom_id tree %>">
  <p>
    <strong>Name:</strong>
    <%= tree.name %>
  </p>

  <p>
    <strong>gender:</strong>
    <%= tree.gender %>
  </p>

  <p>
    <strong>Alive:</strong>
    <%= tree.alive %>
