<div class='mx-auto max-w-md'>
  <div class='card'>
    <div class='card-body'>
      <div class='mb-6 text-center'>
        <%= image_tag 'EAO.png', alt: 'Family Tree', class: 'mx-auto mb-3 size-20 rounded-full' %>
        <h2 class='flex items-center justify-center gap-2 text-2xl font-bold text-slate-800 dark:text-slate-100'>
          <%= heroicon(:arrow_left_on_rectangle, class: 'size-6 text-brand-500') %><%= t('.log_in') %>
        </h2>
        <p class='mt-1 text-sm text-slate-500'><%= t('.welcome_back') %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class='field'>
          <%= f.label :email, t('devise.email'), class: 'label' %>
          <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'input', placeholder: 'your@email.com' %>
        </div>

        <div class='field'>
          <%= f.label :password, t('devise.password'), class: 'label' %>
          <%= f.password_field :password, autocomplete: 'current-password', class: 'input', placeholder: '••••••••' %>
        </div>

        <div class='mb-5 flex items-center justify-between text-sm'>
          <% if devise_mapping.rememberable? %>
            <label class='flex items-center gap-2'>
              <%= f.check_box :remember_me, class: 'rounded border-slate-300 text-brand-500 focus:ring-brand-400' %>
              <%= t('.remember_me') %>
            </label>
          <% end %>
          <%= link_to t('devise.passwords.new.forgot_your_password'), new_password_path(resource_name), class: 'text-brand-600 hover:underline dark:text-brand-300' %>
        </div>

        <%= f.submit t('.log_in'), class: 'btn btn-primary w-full cursor-pointer' %>
      <% end %>

      <%- if devise_mapping.omniauthable? && Devise.omniauth_providers.any? %>
        <div class='my-5 flex items-center gap-3 text-xs text-slate-400'>
          <span class='h-px flex-1 bg-slate-200 dark:bg-slate-700'></span><%= t('.continue_with') %><span class='h-px flex-1 bg-slate-200 dark:bg-slate-700'></span>
        </div>
        <div class='flex justify-center gap-2'>
          <%- Devise.omniauth_providers.each do |provider| %>
            <%= button_to provider.to_s.delete_suffix('_oauth2').capitalize, omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: 'btn btn-secondary' %>
          <% end %>
        </div>
      <% end %>

      <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
        <p class='mt-5 text-center text-xs'>
          <%= link_to t('.didnt_receive_confirmation_instructions'), new_confirmation_path(resource_name), class: 'text-brand-600 hover:underline dark:text-brand-300' %>
        </p>
      <% end %>

      <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
        <p class='mt-4 text-center text-sm text-slate-500'>
          <%= t('.dont_have_account') %>
          <%= link_to t('.sign_up_link'), new_registration_path(resource_name), class: 'font-semibold text-brand-600 hover:underline dark:text-brand-300' %>
        </p>
      <% end %>
    </div>
  </div>
</div>
