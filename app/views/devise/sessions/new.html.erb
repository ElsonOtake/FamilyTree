<div class='columns is-centered'>
  <div class='column is-5'>
    <!-- Login Card -->
    <div class='box'>
      <!-- Logo and Title -->
      <div class='has-text-centered mb-5'>
        <figure class='image is-96x96 is-inline-block mb-4'>
          <img src="<%= asset_path('EAO.png') %>" alt="Family Tree" style="border-radius: 50%;">
        </figure>
        <h2 class='title is-3 has-text-info'>
          <span class='icon-text'>
            <span class='icon'>
              <i class='fas fa-sign-in-alt'></i>
            </span>
            <span><%= t('.log_in') %></span>
          </span>
        </h2>
        <p class='subtitle is-6 has-text-grey'>
          <%= t('.welcome_back') %>
        </p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <!-- Email Field -->
        <div class='field'>
          <%= f.label :email, t('devise.email'), class: 'label' %>
          <div class='control has-icons-left'>
            <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: 'email', 
              class: 'input is-medium', 
              placeholder: 'your@email.com' %>
            <span class='icon is-left'>
              <i class='fas fa-envelope'></i>
            </span>
          </div>
        </div>

        <!-- Password Field -->
        <div class='field'>
          <%= f.label :password, t('devise.password'), class: 'label' %>
          <div class='control has-icons-left'>
            <%= f.password_field :password, 
              autocomplete: 'current-password', 
              class: 'input is-medium', 
              placeholder: '••••••••' %>
            <span class='icon is-left'>
              <i class='fas fa-lock'></i>
            </span>
          </div>
        </div>

        <!-- Remember Me & Forgot Password -->
        <div class='field is-grouped is-grouped-spread mb-5'>
          <% if devise_mapping.rememberable? %>
            <div class='control'>
              <label class='checkbox'>
                <%= f.check_box :remember_me %>
                <span class='ml-2'><%= t('.remember_me') %></span>
              </label>
            </div>
          <% end %>
          <div class='control'>
            <%= link_to t('devise.passwords.new.forgot_your_password'), 
              new_password_path(resource_name), 
              class: 'has-text-info' %>
          </div>
        </div>

        <!-- Submit Button -->
        <div class='field'>
          <%= f.submit t('.log_in'), class: 'button is-info is-fullwidth is-medium' %>
        </div>
      <% end %>

      <!-- OAuth Providers -->
      <%- if devise_mapping.omniauthable? && Devise.omniauth_providers.any? %>
        <hr class='my-5'>
        <p class='has-text-centered has-text-grey mb-4'>
          <%= t('.continue_with') %>
        </p>
        <div class='buttons is-centered'>
          <%- Devise.omniauth_providers.each do |provider| %>
            <%= button_to omniauth_authorize_path(resource_name, provider),
              data: { turbo: false },
              class: 'button is-info is-outlined is-medium' do %>
              <span class='icon'>
                <i class='fab fa-<%= provider.to_s.delete_suffix('_oauth2') %>'></i>
              </span>
              <span><%= provider.to_s.delete_suffix('_oauth2').capitalize %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <!-- Additional Links -->
      <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
        <div class='has-text-centered mt-5'>
          <p class='is-size-7'>
            <%= link_to t('.didnt_receive_confirmation_instructions'), 
              new_confirmation_path(resource_name), 
              class: 'has-text-info' %>
          </p>
        </div>
      <% end %>

      <!-- Sign Up Link -->
      <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
        <div class='has-text-centered mt-4'>
          <p>
            <%= t('.dont_have_account') %> 
            <%= link_to t('.sign_up_link'), new_registration_path(resource_name), class: 'has-text-info has-text-weight-bold' %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
