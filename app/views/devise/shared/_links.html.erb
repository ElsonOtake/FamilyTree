<div class='mt-4 space-y-1 text-center text-sm'>
  <%- if controller_name != 'sessions' %>
    <%= link_to t('devise.sessions.new.log_in', default: 'Log in'), new_session_path(resource_name), class: 'block text-brand-600 hover:underline dark:text-brand-300' %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to t('devise.registrations.new.sign_up', default: 'Sign up'), new_registration_path(resource_name), class: 'block text-brand-600 hover:underline dark:text-brand-300' %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to t('devise.passwords.new.forgot_your_password', default: 'Forgot your password?'), new_password_path(resource_name), class: 'block text-brand-600 hover:underline dark:text-brand-300' %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to t('devise.confirmations.new.resend_confirmation_instructions', default: "Didn't receive confirmation instructions?"), new_confirmation_path(resource_name), class: 'block text-brand-600 hover:underline dark:text-brand-300' %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to t('devise.unlocks.new.resend_unlock_instructions', default: "Didn't receive unlock instructions?"), new_unlock_path(resource_name), class: 'block text-brand-600 hover:underline dark:text-brand-300' %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- Devise.omniauth_providers.each do |provider| %>
      <%= button_to "#{t('devise.sessions.new.log_in', default: 'Sign in')} · #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: 'btn btn-secondary mx-auto mt-2' %>
    <% end %>
  <% end %>
</div>
