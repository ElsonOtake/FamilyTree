<div class='mx-auto max-w-md'>
  <div class='card'>
    <div class='card-body'>
      <div class='mb-6 text-center'>
        <%= image_tag 'EAO.png', alt: 'Family Tree', class: 'mx-auto mb-3 size-20 rounded-full' %>
        <h2 class='flex items-center justify-center gap-2 text-2xl font-bold text-slate-800 dark:text-slate-100'>
          <%= heroicon(:user_plus, class: 'size-6 text-brand-500') %><%= t('.sign_up') %>
        </h2>
        <p class='mt-1 text-sm text-slate-500'><%= t('.create_account_description') %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render 'devise/shared/error_messages', resource: resource %>

        <div class='field'>
          <%= f.label :name, t(:name), class: 'label' %>
          <%= f.text_field :name, autofocus: true, autocomplete: 'name', class: 'input', placeholder: t('.placeholder_name') %>
        </div>
        <div class='field'>
          <%= f.label :email, t('devise.email'), class: 'label' %>
          <%= f.email_field :email, autocomplete: 'email', class: 'input', placeholder: t('.placeholder_email') %>
        </div>
        <div class='field'>
          <%= f.label :phone, t('devise.registrations.phone'), class: 'label' %>
          <%= f.text_field :phone, autocomplete: 'phone', class: 'input', placeholder: t('.placeholder_phone') %>
        </div>

        <div class='mb-4 rounded-xl bg-slate-50 p-4 dark:bg-slate-900/40'>
          <h4 class='card-title mb-3'><%= heroicon(:lock_closed, class: 'size-4 text-amber-500') %><%= t('.password_section') %></h4>
          <div class='field'>
            <%= f.label :password, t('devise.password'), class: 'label' %>
            <%= f.password_field :password, autocomplete: 'new-password', class: 'input', placeholder: t('.placeholder_password') %>
            <% if @minimum_password_length %>
              <p class='mt-1 text-xs text-slate-400'><%= t('devise.characters_minimum', count: @minimum_password_length) %></p>
            <% end %>
          </div>
          <div class='field mb-0'>
            <%= f.label :password_confirmation, t('devise.password_confirmation'), class: 'label' %>
            <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'input', placeholder: t('.placeholder_password_confirmation') %>
          </div>
        </div>

        <label class='mb-4 flex items-center gap-2 text-sm'>
          <input type='checkbox' required class='rounded border-slate-300 text-brand-500 focus:ring-brand-400'>
          <span><%= t('.agree_terms_html') %></span>
        </label>

        <%= f.submit t('.sign_up'), class: 'btn btn-primary w-full cursor-pointer' %>
      <% end %>

      <%- if devise_mapping.omniauthable? && Devise.omniauth_providers.any? %>
        <div class='my-5 flex items-center gap-3 text-xs text-slate-400'>
          <span class='h-px flex-1 bg-slate-200 dark:bg-slate-700'></span><%= t('.or_sign_up_with') %><span class='h-px flex-1 bg-slate-200 dark:bg-slate-700'></span>
        </div>
        <div class='flex justify-center gap-2'>
          <%- Devise.omniauth_providers.each do |provider| %>
            <%= button_to provider.to_s.delete_suffix('_oauth2').capitalize, omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: 'btn btn-secondary' %>
          <% end %>
        </div>
      <% end %>

      <p class='mt-5 text-center text-sm text-slate-500'>
        <%= t('.already_have_account') %>
        <%= link_to t('.sign_in_link'), new_session_path(resource_name), class: 'font-semibold text-brand-600 hover:underline dark:text-brand-300' %>
      </p>
    </div>
  </div>
</div>
