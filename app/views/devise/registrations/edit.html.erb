<div class='mx-auto max-w-2xl'>
  <section class='mb-6 rounded-2xl bg-linear-to-r from-brand-600 to-brand-500 px-6 py-5 text-white shadow-sm'>
    <h1 class='flex items-center gap-2 text-2xl font-bold'>
      <%= heroicon(:pencil_square, class: 'size-6') %><%= t('.edit_user') %>
    </h1>
    <p class='mt-1 text-sm text-white/80'><%= t('.we_need_your_current_password') %></p>
  </section>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %>

    <div class='card mb-5'>
      <div class='card-body space-y-4'>
        <h3 class='card-title'><%= heroicon(:user, class: 'size-5 text-brand-500') %><%= t('.basic_information') %></h3>
        <div class='field'>
          <%= f.label :name, t(:name), class: 'label' %>
          <%= f.text_field :name, autofocus: true, autocomplete: 'name', class: 'input', placeholder: t('.placeholder_name') %>
        </div>
        <div class='field'>
          <%= f.label :email, t('devise.email'), class: 'label' %>
          <%= f.email_field :email, autocomplete: 'email', class: 'input', placeholder: t('.placeholder_email') %>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class='mt-1 text-xs text-amber-600'><%= t('.currently_waiting_confirmation_for') %> <strong><%= resource.unconfirmed_email %></strong></p>
          <% end %>
        </div>
        <div class='field mb-0'>
          <%= f.label :phone, t('devise.registrations.phone'), class: 'label' %>
          <%= f.text_field :phone, autocomplete: 'phone', class: 'input', placeholder: t('.placeholder_phone') %>
        </div>
      </div>
    </div>

    <div class='card mb-5'>
      <div class='card-body space-y-4'>
        <h3 class='card-title'><%= heroicon(:lock_closed, class: 'size-5 text-amber-500') %><%= t('.security_settings') %></h3>
        <p class='rounded-lg bg-blue-50 px-3 py-2 text-xs text-blue-800 dark:bg-blue-900/30 dark:text-blue-200'><%= t('.leave_blank') %></p>
        <div class='field'>
          <%= f.label :password, t('devise.password'), class: 'label' %>
          <%= f.password_field :password, autocomplete: 'new-password', class: 'input', placeholder: t('.placeholder_new_password') %>
          <% if @minimum_password_length %>
            <p class='mt-1 text-xs text-slate-400'><%= t('devise.characters_minimum', count: @minimum_password_length) %></p>
          <% end %>
        </div>
        <div class='field'>
          <%= f.label :password_confirmation, t('devise.password_confirmation'), class: 'label' %>
          <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'input', placeholder: t('.placeholder_confirm_password') %>
        </div>
        <div class='field mb-0 border-t border-slate-100 pt-4 dark:border-slate-700'>
          <%= f.label :current_password, t('.current_password'), class: 'label' %>
          <%= f.password_field :current_password, autocomplete: 'current-password', class: 'input', placeholder: t('.placeholder_current_password') %>
          <p class='mt-1 text-xs text-red-600'><%= t('.we_need_your_current_password') %></p>
        </div>
      </div>
    </div>

    <div class='flex justify-center gap-3'>
      <%= f.submit t('.update'), class: 'btn btn-primary cursor-pointer' %>
      <%= link_to root_path, class: 'btn btn-secondary' do %>
        <%= heroicon(:arrow_left, class: 'size-5') %><span><%= t('people.show.back_to_people') %></span>
      <% end %>
    </div>
  <% end %>

  <div class='card mt-6 border border-red-200 dark:border-red-900'>
    <div class='card-body'>
      <h3 class='mb-2 flex items-center gap-2 text-sm font-semibold text-red-600'>
        <%= heroicon(:trash, class: 'size-5') %><%= t('.danger_zone') %>
      </h3>
      <p class='mb-4 text-sm text-slate-600 dark:text-slate-300'><%= t('.unhappy') %></p>
      <%= button_to t('.cancel_my_account'), registration_path(resource_name), class: 'btn btn-danger',
          form: { data: { turbo_confirm: t('.are_you_sure') } }, method: :delete %>
    </div>
  </div>
</div>
