<div class='mx-auto max-w-md'>
  <div class='card'>
    <div class='card-body'>
      <div class='mb-6 text-center'>
        <span class='mx-auto mb-3 flex size-16 items-center justify-center rounded-full bg-brand-50 text-brand-500 dark:bg-slate-700'>
          <%= heroicon(:key, class: 'size-8') %>
        </span>
        <h2 class='text-2xl font-bold text-slate-800 dark:text-slate-100'><%= t('.change_password') %></h2>
        <p class='mt-1 text-sm text-slate-500'><%= t('devise.passwords.edit.instruction_text') %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render 'devise/shared/error_messages', resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <% if @minimum_password_length %>
          <p class='mb-4 rounded-lg bg-blue-50 px-3 py-2 text-xs text-blue-800 dark:bg-blue-900/30 dark:text-blue-200'>
            <strong><%= t('devise.passwords.edit.requirements_title') %></strong> ·
            <%= t('devise.characters_minimum', count: @minimum_password_length) %>
          </p>
        <% end %>

        <div class='field'>
          <%= f.label :password, t('.new_password'), class: 'label' %>
          <%= f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'input',
              placeholder: t('devise.passwords.edit.new_password_placeholder') %>
          <p class='mt-1 text-xs text-slate-400'><%= t('devise.passwords.edit.password_tip') %></p>
        </div>

        <div class='field'>
          <%= f.label :password_confirmation, t('.new_password_confirmation'), class: 'label' %>
          <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'input',
              placeholder: t('devise.passwords.edit.confirm_password_placeholder') %>
        </div>

        <%= f.submit t('.change_password'), class: 'btn btn-primary mt-2 w-full cursor-pointer' %>
      <% end %>

      <div class='mt-6 border-t border-slate-100 pt-5 text-center dark:border-slate-700'>
        <%= link_to new_session_path(resource_name), class: 'btn btn-secondary' do %>
          <%= heroicon(:arrow_left_on_rectangle, class: 'size-5') %><span><%= t('devise.shared.links.sign_in') %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>
