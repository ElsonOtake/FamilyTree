<h2 class="title has-text-info"><%= t('.change_password') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <%= f.label :password, t('.new_password'), class: "label" %>
    <div class="control">
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input" %>
    </div>
    <% if @minimum_password_length %>
      <span class="help is-danger"><%= t('devise.characters_minimum', count: @minimum_password_length) %></span>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, t('.new_password_confirmation'), class: "label" %>
    <div class="control">
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
    </div>
  </div>

  <div class="actions">
    <%= f.submit t('.change_password'), class: "button is-link" %>
  </div>
<% end %>
