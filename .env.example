# Copy to .env and fill in. .env is gitignored — never commit real values.
# Only the "Local development" values are needed to run the app locally.
# The "Production" section is for deploying your own instance.

# ─── Local development (required) ──────────────────────────────────────
# Postgres credentials for the development and test databases.
DATABASE_DEV_USERNAME=postgres
DATABASE_DEV_PASSWORD=

# ─── Local development (optional) ──────────────────────────────────────
# Google OAuth login. Leave blank to disable "Sign in with Google" locally.
GOOGLE_ID=
GOOGLE_SECRET=

# Contact address shown on the About page and in email footers.
CONTACT_EMAIL=contact@example.com
# From/sender address for outgoing mail (mailer default + Devise sender).
MAILER_FROM=no-reply@example.com

# ─── Production / self-hosting ─────────────────────────────────────────
# Full Postgres connection URL for the production database.
DATABASE_URL=

# Outgoing mail via Gmail SMTP (see config/environments/production.rb).
# MAILER_FROM should match GMAIL_USERNAME unless it is a verified Gmail alias.
GMAIL_USERNAME=user@example.com
GMAIL_APP_PASSWORD=

# S3-compatible object storage (e.g. Tigris) for Active Storage uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
BUCKET_NAME=
