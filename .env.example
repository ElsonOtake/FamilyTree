# Copy to .env and fill in. .env is gitignored — never commit real values.

# Contact address shown on the About page (mailto link).
CONTACT_EMAIL=contact@example.com

# From/sender address for outgoing mail (mailer default + Devise sender).
MAILER_FROM=no-reply@example.com

# SMTP credentials for production mail delivery (Gmail SMTP by default).
GMAIL_USERNAME=user@example.com
GMAIL_APP_PASSWORD=
